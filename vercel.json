{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run verify",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.mppublicschool.online" }], "destination": "https://mppublicschool.online/:path*", "permanent": true },
    { "source": "/privacypolicy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/admissions/2025", "destination": "/admissions", "permanent": true },
    { "source": "/admissions/:year(\\d{4})", "destination": "/admissions", "permanent": true },
    { "source": "/results", "destination": "/news", "permanent": true },
    { "source": "/result", "destination": "/news", "permanent": true },
    { "source": "/faqs", "destination": "/admissions#faq", "permanent": true },
    { "source": "/faq", "destination": "/admissions#faq", "permanent": true },
    { "source": "/notices", "destination": "/news", "permanent": true },
    { "source": "/notice", "destination": "/news", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/gallery/:path*", "destination": "/gallery", "permanent": true },
    { "source": "/blog/:path*", "destination": "/news", "permanent": true },
    { "source": "/category/:path*", "destination": "/news", "permanent": true },
    { "source": "/tag/:path*", "destination": "/news", "permanent": true },
    { "source": "/author/:path*", "destination": "/", "permanent": true },
    { "source": "/feed", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/admissions/apply", "destination": "/admissions", "permanent": true },
    { "source": "/admissions/enquiry", "destination": "/admissions#inquiry-form", "permanent": true },
    { "source": "/admissions/process", "destination": "/admissions", "permanent": true },
    { "source": "/admissions-open", "destination": "/admissions", "permanent": true },
    { "source": "/about/overview", "destination": "/about", "permanent": true },
    { "source": "/about/principal", "destination": "/#principal-message", "permanent": true },
    { "source": "/affiliation-details", "destination": "/disclosure", "permanent": true },
    { "source": "/recognition-certificates", "destination": "/disclosure", "permanent": true },
    { "source": "/academic-calendar", "destination": "/academics", "permanent": true },
    { "source": "/downloads", "destination": "/disclosure", "permanent": true },
    { "source": "/facilities/library", "destination": "/facilities", "permanent": true },
    { "source": "/facilities/sports", "destination": "/facilities", "permanent": true },
    { "source": "/facilities/safety-security", "destination": "/facilities", "permanent": true },
    { "source": "/academics/pre-primary", "destination": "/academics", "permanent": true },
    { "source": "/academics/primary", "destination": "/academics", "permanent": true },
    { "source": "/academics/middle", "destination": "/academics", "permanent": true },
    { "source": "/academics/secondary", "destination": "/academics", "permanent": true },
    { "source": "/academics/senior-secondary", "destination": "/academics", "permanent": true },
    { "source": "/sitemap", "destination": "/sitemap-index.xml", "permanent": true }
  ]
}

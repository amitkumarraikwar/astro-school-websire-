---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import FeeSchedule from '@/components/sections/FeeSchedule.astro';
import InquiryForm from '@/components/sections/InquiryForm.astro';
import { siteConfig } from '@/config/site';
import { getBreadcrumbList, getFAQPage } from '@/lib/schema';

const steps = [
  { title: 'Speak with the office', desc: 'Call, send an enquiry, or visit to discuss the class, campus, session, and available places.' },
  { title: 'Confirm requirements', desc: 'Ask the office for the applicable age criteria, subject options, document list, and whether an interaction or assessment is required.' },
  { title: 'Review the fees and terms', desc: 'Obtain a written fee breakdown, payment schedule, any eligible concessions, and cancellation and refund terms before paying.' },
  { title: 'Complete admission at the school', desc: 'Submit the documents requested by the office. Enrolment is complete only when the school confirms admission and issues the relevant records.' },
];
const documents = ['Student photograph', 'Date-of-birth information and supporting proof', 'Previous school details and transfer certificate, where applicable', 'Previous class academic record, where applicable', 'Parent / guardian contact and address details'];
const faqs = [
  { question: 'Which board does the school follow?', answer: `The school follows MP Board. The school information supplied to this website lists affiliation number ${siteConfig.affiliationNumber}. Contact the office for the current recognition and affiliation documents.` },
  { question: 'Does an enquiry reserve a seat?', answer: 'No. An enquiry allows you to discuss admission with the school. Availability, eligibility, document verification, and school confirmation determine admission.' },
  { question: 'What is the minimum admission age?', answer: 'Age requirements depend on the class and the applicable rules for the admission session. Please confirm the age cut-off and required date-of-birth documents with the school office.' },
  { question: 'Which senior-secondary streams are listed?', answer: 'Science and Commerce are listed for Classes XI and XII in the supplied fee schedule. Confirm the subjects and current availability with the office.' },
  { question: 'How do I confirm fees or discounts?', answer: 'Review the undiscounted 2026–27 tuition schedule below, then ask for a written breakdown for your campus, class, and shift. Discount eligibility and validity must be confirmed before payment.' },
  { question: 'How is school transport arranged?', answer: 'The supplied schedule says parents contact vehicle operators directly and pay transport charges separately. Ask the office about available operators, routes, and collection arrangements.' },
  { question: 'What are the school timings?', answer: 'The M.P. Public School schedule lists Pre-Nursery / Nursery at 9:30 AM–12:30 PM, K.G. I–II at 9:30 AM–1:30 PM, Classes I–V at 9:30 AM–2:30 PM, and Classes VI–XII at 7:45 AM–1:15 PM. Examination timings and junior-branch shifts differ; confirm the current timetable with the office.' },
];
const breadcrumbLd = getBreadcrumbList([{ name: 'Home', item: `${siteConfig.url}/` }, { name: 'Admissions', item: `${siteConfig.url}/admissions` }]);
---

<BaseLayout title="Admissions & Fees" description="Explore M.P. Public School Indore admission enquiries, eligibility guidance, documents, 2026–27 tuition fees, and school office contacts." jsonLd={[breadcrumbLd, getFAQPage(faqs)]}>
  <section class="gradient-hero py-20 md:py-28">
    <div class="container">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-white/75"><a href="/" class="underline">Home</a> / Admissions</nav>
      <span class="badge badge-amber mb-4">School Admission Information</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Admissions & Fees</h1>
      <p class="text-lg text-white/85 max-w-2xl mb-8">Considering M.P. Public School for your child? Speak with our office about class availability, eligibility, fees, and a campus visit.</p>
      <div class="flex flex-wrap gap-4"><Button href="#inquiry-form">Make an Enquiry</Button><Button href="#fees" variant="outline-dark">View Tuition Schedule</Button><Button href={`tel:${siteConfig.phones[0].replace(/\s/g, '')}`} variant="outline-dark">Call the School</Button></div>
    </div>
  </section>
  <section class="section bg-white">
    <div class="container">
      <SectionHeading title="How to Enquire About Admission" subtitle="The school office will explain the requirements for your child's class and session." />
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {steps.map((step, i) => <div class="card p-6"><span class="badge badge-indigo mb-3">Step {i + 1}</span><h2 class="text-xl font-bold mb-3">{step.title}</h2><p class="text-[var(--color-ink-light)]">{step.desc}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section bg-[var(--color-cream)]">
    <div class="container container-sm prose">
      <h2>Documents and Eligibility</h2>
      <p>The school diary includes the following information for enrolment. Obtain the complete class-specific document list from the office; do not send identity documents through the website enquiry form.</p>
      <ul>{documents.map(document => <li>{document}</li>)}</ul>
      <p><a href={siteConfig.documents.diary} target="_blank" rel="noopener noreferrer">Read the school diary, rules, and academic calendar (PDF)</a>.</p>
    </div>
  </section>
  <section class="section bg-white" id="fees">
    <div class="container"><SectionHeading title={`Tuition Schedule (${siteConfig.academicSession})`} subtitle="Published tuition, separate admission charges, and information to confirm before enrolment." /><FeeSchedule /></div>
  </section>
  <section class="section bg-[var(--color-cream)]" id="faq">
    <div class="container"><SectionHeading title="Admission Questions" /><FAQAccordion faqs={faqs} /></div>
  </section>
  <section class="section bg-white" id="inquiry-form">
    <div class="container"><SectionHeading title="Admission Enquiry" subtitle="Send your question to the school. For a time-sensitive enquiry, please call during office hours." /><div class="max-w-2xl mx-auto"><InquiryForm kind="admission" /></div></div>
  </section>
</BaseLayout>

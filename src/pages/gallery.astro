---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { siteConfig } from '@/config/site';
import { getBreadcrumbList } from '@/lib/schema';

const breadcrumbLd = getBreadcrumbList([
  { name: 'Home', item: 'https://mppublicschool.online/' },
  { name: 'Gallery', item: 'https://mppublicschool.online/gallery' },
]);

const categories = [
  { id: 'all', label: 'All' },
  { id: 'campus', label: 'Campus' },
  { id: 'events', label: 'Events' },
  { id: 'sports', label: 'Sports' },
  { id: 'annual-day', label: 'Annual Day' },
  { id: 'classroom', label: 'Classroom' },
];

// Gallery items with real photos and placeholders
const galleryItems = [
  { title: 'School Front Entrance', category: 'campus', alt: 'M.P. Public School main building entrance', src: '/mpps_front.jpeg', gradient: 'from-[#43449A] to-[#2A2B6B]' },
  { title: 'Campus & Architecture', category: 'campus', alt: 'M.P. Public School campus view', src: '/mpps_front1.jpeg', gradient: 'from-[#2A2B6B] to-[#29ABE2]' },
  { title: 'Director - Mr. Dilip Budhani', category: 'events', alt: 'Director Mr. Dilip Budhani', src: '/mpps_director.jpeg', gradient: 'from-[#43449A] to-[#E8541E]' },
  { title: 'Annual Day Celebrations', category: 'annual-day', alt: 'Students performing during Annual Day', src: '', gradient: 'from-[#E3242B] to-[#C41E24]' },
  { title: 'Cricket & Sports Facilities', category: 'sports', alt: 'Sports grounds and activities', src: '', gradient: 'from-[#29ABE2] to-[#1D7BA3]' },
  { title: 'Smart Classroom Session', category: 'classroom', alt: 'Smart classroom learning environment', src: '', gradient: 'from-[#FDC530] to-[#E8B020]' },
  { title: 'Science & Art Exhibition', category: 'events', alt: 'Students showcasing project models', src: '', gradient: 'from-[#E8541E] to-[#C44818]' },
  { title: 'School Campus Front View', category: 'campus', alt: 'Wide view of school campus', src: '/mpps_front1.jpeg', gradient: 'from-[#43449A] to-[#5B5CB8]' },
  { title: 'Republic Day Flag Ceremony', category: 'events', alt: 'Flag hoisting ceremony on Republic Day', src: '', gradient: 'from-[#E3232B] to-[#43449A]' },
  { title: 'Sports Meet & Athletics', category: 'sports', alt: 'School sports meet', src: '', gradient: 'from-[#29ABE2] to-[#43449A]' },
  { title: 'Annual Excellence Awards', category: 'annual-day', alt: 'Awards presentation ceremony', src: '', gradient: 'from-[#FDC530] to-[#43449A]' },
  { title: 'Interactive Learning Labs', category: 'classroom', alt: 'Modern computer lab and learning center', src: '', gradient: 'from-[#2A2B6B] to-[#29ABE2]' },
];
---

<BaseLayout
  title="Gallery – Photos & Memories"
  description="Browse the photo gallery of M.P. Public School Indore featuring campus, events, sports, Annual Day celebrations, and classroom activities."
  jsonLd={breadcrumbLd}
>
  <!-- Page Hero -->
  <section class="gradient-hero py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="container relative">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/60">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-white font-medium">Gallery</li>
        </ol>
      </nav>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">Photo Gallery</h1>
      <p class="text-lg text-white/75 max-w-2xl mb-4">Capturing moments of learning, celebration, and achievement at M.P. Public School, Indore.</p>
      
      <!-- AEO Quick Answer -->
      <p class="text-lg text-white/90 max-w-3xl bg-white/10 p-4 rounded-xl border border-white/20 backdrop-blur">
        <strong>Quick Answer:</strong> Browse through the photo gallery of {siteConfig.name} to see our campus, state-of-the-art facilities, sporting events, annual day celebrations, and everyday classroom activities.
      </p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section bg-white">
    <div class="container">
      <!-- Category Filter -->
      <div class="flex flex-wrap justify-center gap-2 mb-12" id="gallery-filter" data-animate="fade-up">
        {categories.map((cat) => (
          <button
            class:list={['gallery-filter-btn px-5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200', cat.id === 'all' ? 'bg-[var(--color-indigo)] text-white' : 'bg-[var(--color-gray-100)] text-[var(--color-ink-light)] hover:bg-[var(--color-indigo)]/10']}
            data-filter={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Masonry Grid -->
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6" id="gallery-grid">
        {galleryItems.map((item, i) => (
          <div
            class="gallery-item break-inside-avoid rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 cursor-pointer group"
            data-category={item.category}
            role="button"
            tabindex="0"
            aria-label={`View: ${item.title}`}
          >
            <div class:list={[
              'relative bg-gradient-to-br overflow-hidden',
              item.gradient,
              i % 3 === 0 ? 'aspect-[4/5]' : i % 3 === 1 ? 'aspect-[4/3]' : 'aspect-square',
            ]}>
              {item.src ? (
                <img 
                  src={item.src} 
                  alt={item.alt} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy" 
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <svg class="w-16 h-16 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              )}

              <!-- Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5">
                <div>
                  <h3 class="text-white font-semibold text-base mb-0.5">{item.title}</h3>
                  <span class="text-white/80 text-xs uppercase font-medium tracking-wider">{item.category.replace('-', ' ')}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Gallery filter
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-[var(--color-indigo)]', 'text-white');
        b.classList.add('bg-[var(--color-gray-100)]', 'text-[var(--color-ink-light)]');
      });
      btn.classList.add('bg-[var(--color-indigo)]', 'text-white');
      btn.classList.remove('bg-[var(--color-gray-100)]', 'text-[var(--color-ink-light)]');

      const filter = btn.getAttribute('data-filter');

      galleryItems.forEach((item) => {
        const category = item.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Simple lightbox
  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const title = item.querySelector('h3')?.textContent || '';
      // For now, show title. Replace with full lightbox when actual images are added.
      // Full lightbox implementation would go here with actual image src
    });
  });
</script>

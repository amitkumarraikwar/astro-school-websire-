---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for does not exist. Return to the M.P. Public School Indore homepage."
  noindex={true}
>
  <section class="min-h-[70vh] flex items-center justify-center gradient-hero relative overflow-hidden">
    <!-- Decorative -->
    <div class="absolute top-[20%] right-[15%] w-32 h-32 rounded-full bg-[var(--color-amber)]/10 blur-2xl"></div>
    <div class="absolute bottom-[20%] left-[10%] w-24 h-24 rounded-full bg-[var(--color-red)]/10 blur-2xl"></div>

    <div class="container relative text-center py-20">
      <div class="mb-8">
        <span class="text-[120px] md:text-[180px] font-bold text-white/10 leading-none select-none">404</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4 -mt-12 md:-mt-20">
        Page Not Found
      </h1>
      <p class="text-lg text-white/70 max-w-lg mx-auto mb-8">
        Oops! The page you're looking for doesn't exist or may have been moved. Let's get you back on track.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button variant="secondary" size="lg" href="/">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Home
        </Button>
        <Button size="lg" href="/contact" class="bg-white/10 text-white border-2 border-white/30 hover:bg-white/20">
          Contact Us
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

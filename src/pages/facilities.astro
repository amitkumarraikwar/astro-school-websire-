---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import AdmissionCTA from '@/components/sections/AdmissionCTA.astro';
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/config/site';
const facilities = [
  { title: 'Classrooms and Campus', description: `The supplied infrastructure record lists ${siteConfig.stats.classrooms} classrooms and a ${siteConfig.campusArea} campus. Smart classroom facilities are listed in the school programme.` },
  { title: 'Laboratories and Computer Facilities', description: 'The school infrastructure record lists four laboratories. Computer facilities are also listed among the school amenities. Arrange a visit to discuss the resources used by your child’s class.' },
  { title: 'Library', description: 'The school has a library for reading and learning resources. Ask the school about library use and the resources available for different classes.' },
  { title: 'Games, Sports, and Creative Activities', description: 'The school programme lists indoor and outdoor games, sports, yoga, music, dance, art and craft, and cultural and literary activities.' },
  { title: 'Campus Surveillance', description: 'CCTV surveillance is listed in the school programme. Parents can ask the office about visitor access, student collection arrangements, and campus procedures.' },
  { title: 'Transport Arrangements', description: 'The fee schedule states that parents can contact vehicle operators directly and pay transport charges separately. Confirm routes, charges, pickup arrangements, and vehicle provisions with the operator.' },
];
---

<BaseLayout title="Campus Facilities" description="M.P. Public School Indore classrooms, laboratories, library, computer facilities, activities, CCTV, and separately arranged transport information.">
  <section class="gradient-hero py-20 md:py-28"><div class="container"><nav aria-label="Breadcrumb" class="mb-6 text-sm text-white/75"><a href="/" class="underline">Home</a> / Facilities</nav><h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Campus Facilities</h1><p class="text-lg text-white/85 max-w-2xl">Explore the facilities listed in the school records and programme. A campus visit is a useful way to discuss your child's daily school experience.</p></div></section>
  <section class="section bg-white"><div class="container"><SectionHeading title="Learning and School Life" subtitle="Classrooms, resources, and activities at M.P. Public School." /><div class="grid md:grid-cols-2 gap-6">{facilities.map(facility => <div class="card p-8"><h2 class="text-2xl font-bold mb-3">{facility.title}</h2><p class="text-[var(--color-ink-light)] leading-relaxed">{facility.description}</p></div>)}</div><div class="flex flex-wrap justify-center gap-4 mt-10"><Button href="/contact">Arrange a Campus Visit</Button><Button href="/gallery" variant="outline-light">View School Images</Button></div></div></section>
  <AdmissionCTA />
</BaseLayout>

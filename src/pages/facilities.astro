---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import AdmissionCTA from '@/components/sections/AdmissionCTA.astro';
import { siteConfig } from '@/config/site';
import { getBreadcrumbList } from '@/lib/schema';

const breadcrumbLd = getBreadcrumbList([
  { name: 'Home', item: 'https://mppublicschool.online/' },
  { name: 'Facilities', item: 'https://mppublicschool.online/facilities' },
]);

const facilities = [
  {
    title: 'Smart Classrooms',
    description: 'Every classroom is equipped with interactive whiteboards, HD projectors, and digital learning software integrated with the CBSE curriculum. Our smart classrooms transform traditional teaching into an engaging, multimedia experience that caters to different learning styles.',
    features: ['Interactive whiteboards', 'HD projectors', 'Digital curriculum tools', 'Ergonomic furniture', 'Air-conditioned rooms'],
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    title: 'Library & Resource Center',
    description: 'Our library houses over 15,000 books, journals, and magazines across multiple languages. The digital library section provides access to e-books, online encyclopedias, and educational databases, fostering a lifelong love for reading.',
    features: ['15,000+ books', 'Digital library access', 'Reading rooms', 'Periodicals section', 'Reference materials'],
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  },
  {
    title: 'Science Laboratories',
    description: 'State-of-the-art Physics, Chemistry, and Biology laboratories equipped with modern instruments and safety equipment. Students conduct regular practical experiments that complement their theoretical learning.',
    features: ['Physics lab', 'Chemistry lab', 'Biology lab', 'Modern equipment', 'Safety protocols'],
    icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  },
  {
    title: 'Sports Complex',
    description: 'A comprehensive sports facility featuring a full-size cricket ground, basketball court, athletics track, and indoor games area. Professional coaches train students in various sports, producing district and state-level athletes.',
    features: ['Cricket ground', 'Basketball court', 'Athletics track', 'Indoor badminton', 'Table tennis'],
    icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
  },
  {
    title: 'Computer Lab',
    description: 'Modern computer labs with the latest hardware and high-speed internet connectivity. Students learn programming, digital literacy, and explore emerging technologies like robotics and artificial intelligence.',
    features: ['Latest computers', 'High-speed internet', 'Coding curriculum', 'Robotics kit', 'Multimedia tools'],
    icon: 'M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z',
  },
  {
    title: 'Transport',
    description: 'A fleet of well-maintained, GPS-enabled school buses covering major routes across Indore. Each bus has a trained driver, attendant, and first-aid kit, ensuring safe commute for every student.',
    features: ['GPS tracking', 'Trained drivers', 'CCTV cameras', 'First-aid equipped', 'Wide route coverage'],
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'Cafeteria',
    description: 'A hygienic and spacious cafeteria serving nutritious meals and snacks. The menu is regularly reviewed by a nutritionist to ensure balanced and healthy food options for growing students.',
    features: ['Hygienic kitchen', 'Nutritious menu', 'Spacious seating', 'RO water facility', 'Vegetarian options'],
    icon: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z',
  },
  {
    title: 'Security & Safety',
    description: 'Comprehensive security infrastructure including CCTV surveillance throughout the campus, trained security personnel, fire safety equipment, and strict visitor management protocols to ensure a safe learning environment.',
    features: ['CCTV surveillance', 'Trained security', 'Fire safety', 'Visitor management', 'Emergency protocols'],
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
];
---

<BaseLayout
  title="Facilities – Campus Infrastructure"
  description="Explore the world-class facilities at M.P. Public School Indore — smart classrooms, science labs, sports complex, library, computer lab, transport, and more."
  jsonLd={breadcrumbLd}
>
  <!-- Page Hero -->
  <section class="gradient-hero py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="container relative">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/60">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-white font-medium">Facilities</li>
        </ol>
      </nav>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">Our Facilities</h1>
      <p class="text-lg text-white/75 max-w-2xl mb-4">World-class infrastructure designed to provide the best learning environment for every student at M.P. Public School, Indore.</p>
      
      <!-- AEO Quick Answer -->
      <p class="text-lg text-white/90 max-w-3xl bg-white/10 p-4 rounded-xl border border-white/20 backdrop-blur">
        <strong>Quick Answer:</strong> {siteConfig.name} offers state-of-the-art facilities including smart classrooms, well-equipped science and computer labs, a rich library, expansive sports complexes, and a GPS-enabled transport fleet for comprehensive student development.
      </p>
    </div>
  </section>

  <!-- Facilities -->
  <section class="section bg-white">
    <div class="container">
      <div class="space-y-16">
        {facilities.map((facility, i) => (
          <div class:list={['grid md:grid-cols-2 gap-10 items-center', i % 2 !== 0 ? 'md:[&>*:first-child]:order-2' : '']} data-animate="fade-up">
            <!-- Content -->
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-xl bg-[var(--color-indigo)]/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-[var(--color-indigo)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d={facility.icon} />
                  </svg>
                </div>
                <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-ink)]">{facility.title}</h2>
              </div>
              <p class="text-[var(--color-ink-light)] leading-relaxed mb-6">{facility.description}</p>
              <div class="flex flex-wrap gap-2">
                {facility.features.map((feature) => (
                  <span class="px-3 py-1.5 rounded-lg bg-[var(--color-indigo)]/5 text-xs font-medium text-[var(--color-indigo)]">{feature}</span>
                ))}
              </div>
            </div>

            <!-- Image placeholder -->
            <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-lg bg-gradient-to-br from-[var(--color-gray-100)] to-[var(--color-gray-50)]">
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-20 h-20 text-[var(--color-gray-300)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={facility.icon} />
                </svg>
              </div>
              <!-- PLACEHOLDER: Replace with actual facility photos -->
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <AdmissionCTA />
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import AdmissionCTA from '@/components/sections/AdmissionCTA.astro';
import DirectorMessage from '@/components/sections/DirectorMessage.astro';
import { Image } from 'astro:assets';
import frontImg from '@/assets/images/mpps_front.jpeg';
import { siteConfig } from '@/config/site';
import { getBreadcrumbList } from '@/lib/schema';

const breadcrumbLd = getBreadcrumbList([
  { name: 'Home', item: `${siteConfig.url}/` },
  { name: 'About Us', item: `${siteConfig.url}/about` },
]);
const facts = [
  ['School name', siteConfig.fullName],
  ['Board', `${siteConfig.board} · Affiliation No. ${siteConfig.affiliationNumber}`],
  ['Classes', 'Pre-Primary to Class XII'],
  ['Senior secondary', 'Science and Commerce; confirm subject combinations with the office'],
  ['Campus area', siteConfig.campusArea],
  ['Infrastructure', '19 classrooms, 4 laboratories, 1 library, 9 office rooms'],
  ['Address', siteConfig.address],
  ['Office hours', siteConfig.workingHours],
];
---

<BaseLayout title="About Our School" description="Learn about M.P. Public Higher Secondary School at Ashok Nagar, Indore, its MP Board affiliation, campus, leadership, and learning programme." pageType="AboutPage" jsonLd={breadcrumbLd}>
  <section class="gradient-hero py-20 md:py-28">
    <div class="container">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-white/75"><a href="/" class="underline">Home</a> / About Us</nav>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">About Our School</h1>
      <p class="text-lg text-white/85 max-w-2xl">M.P. Public Higher Secondary School serves families in Indore from its Ashok Nagar campus, with classes from Pre-Primary to Class XII.</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <SectionHeading title="Learning at M.P. Public School" align="left" />
        <div class="prose">
          <p>Our school follows the MP Board curriculum. Science and Commerce are listed for Classes XI and XII in the school fee schedule; the office can explain the subjects available for the current session.</p>
          <p>Classroom learning is accompanied by music, dance, art and craft, games, sports, yoga, and cultural and literary activities. The campus infrastructure includes classrooms, laboratories, computer facilities, and a library.</p>
          <p>Parents are welcome to contact the office to discuss admission, school timings, fees, and a campus visit. Our junior branch, {siteConfig.juniorBranch.name}, is located at {siteConfig.juniorBranch.address}.</p>
        </div>
        <div class="flex flex-wrap gap-4 mt-8">
          <Button href="/contact">Contact the School</Button>
          <Button href="/disclosure" variant="outline-light">School Information & Documents</Button>
        </div>
      </div>
      <div>
        <Image src={frontImg} alt="M.P. Public School building, Indore" class="w-full rounded-3xl shadow-xl mb-6" widths={[400, 800]} sizes="(max-width: 1024px) 100vw, 50vw" loading="lazy" />
        <div class="card overflow-hidden">
          <table class="w-full text-sm text-left">
            <caption class="bg-[var(--color-indigo)] p-4 font-bold text-white">School at a Glance</caption>
            <tbody class="divide-y divide-[var(--color-gray-200)]">
              {facts.map(([label, value]) => <tr><th scope="row" class="p-4 align-top">{label}</th><td class="p-4 text-[var(--color-ink-light)]">{value}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <DirectorMessage />
  <AdmissionCTA />
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { siteConfig } from '@/config/site';
import { getBreadcrumbList } from '@/lib/schema';

const breadcrumbLd = getBreadcrumbList([
  { name: 'Home', item: 'https://mppublicschool.online/' },
  { name: 'News & Events', item: 'https://mppublicschool.online/news' },
]);

const news = [
  {
    slug: 'cbse-results-2025',
    title: 'MP Board Results 2025 – School Achieves 98% Pass Rate',
    description: 'Students shine in MP Board Examinations with outstanding results and 15 students scoring above 95%.',
    date: '2025-05-15',
    dateDisplay: 'May 15, 2025',
    category: 'achievement',
    featured: true,
  },
  {
    slug: 'smart-classrooms-inauguration',
    title: 'New Smart Classrooms Inaugurated with Interactive Technology',
    description: '20 classrooms upgraded with interactive whiteboards, projectors, and digital learning tools.',
    date: '2025-07-10',
    dateDisplay: 'July 10, 2025',
    category: 'announcement',
    featured: true,
  },
  {
    slug: 'annual-sports-day-2025',
    title: 'Annual Sports Day 2025 – A Grand Celebration of Sportsmanship',
    description: 'Over 800 students participated in various athletic events showcasing teamwork and sporting spirit.',
    date: '2025-02-20',
    dateDisplay: 'February 20, 2025',
    category: 'event',
    featured: false,
  },
];

const events = [
  { title: 'Annual Day Celebration 2025', date: 'Dec 15', time: '4:00 PM', venue: 'School Auditorium', category: 'cultural' },
  { title: 'Inter-School Sports Tournament', date: 'Nov 20–22', time: '8:00 AM', venue: 'Sports Complex', category: 'sports' },
  { title: 'Science Exhibition 2025', date: 'Oct 25', time: '10:00 AM', venue: 'School Campus', category: 'academic' },
  { title: 'Parent-Teacher Meeting', date: 'Oct 10', time: '9:00 AM', venue: 'Classrooms', category: 'general' },
];

const categoryColors: Record<string, string> = {
  achievement: 'badge-amber',
  announcement: 'badge-indigo',
  event: 'badge-red',
  general: 'bg-[var(--color-gray-200)] text-[var(--color-ink)]',
  cultural: 'badge-indigo',
  sports: 'badge-red',
  academic: 'badge-amber',
};
---

<BaseLayout
  title="News & Events – Latest Updates"
  description="Stay updated with the latest news, announcements, achievements, and upcoming events at M.P. Public School Indore."
  jsonLd={breadcrumbLd}
>
  <!-- Page Hero -->
  <section class="gradient-hero py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="container relative">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/60">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-white font-medium">News & Events</li>
        </ol>
      </nav>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">News & Events</h1>
      <p class="text-lg text-white/75 max-w-2xl mb-4">Stay connected with the latest happenings, achievements, and upcoming activities at M.P. Public School, Indore.</p>
      
      <!-- AEO Quick Answer -->
      <p class="text-lg text-white/90 max-w-3xl bg-white/10 p-4 rounded-xl border border-white/20 backdrop-blur">
        <strong>Quick Answer:</strong> Find the latest updates, circulars, student achievements, and upcoming event schedules for {siteConfig.name} right here. Check our calendar for important dates like examinations and annual functions.
      </p>
    </div>
  </section>

  <!-- News Articles -->
  <section class="section bg-white">
    <div class="container">
      <SectionHeading title="Latest News" subtitle="Updates, achievements, and announcements from M.P. Public School." />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" data-animate="stagger">
        {news.map((article) => (
          <a href={`/news/${article.slug}`} class="card group">
            <div class="aspect-[16/10] bg-gradient-to-br from-[var(--color-indigo)] to-[var(--color-indigo-deep)] relative overflow-hidden">
              <div class="absolute inset-0 flex items-center justify-center">
                <svg class="w-16 h-16 text-white/15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
              </div>
              <div class="absolute top-3 left-3">
                <span class:list={['badge', categoryColors[article.category] || 'badge-indigo']}>{article.category}</span>
              </div>
              {article.featured && (
                <div class="absolute top-3 right-3">
                  <span class="badge bg-white/20 text-white">Featured</span>
                </div>
              )}
            </div>
            <div class="p-6">
              <time class="text-xs text-[var(--color-ink-light)] font-medium" datetime={article.date}>{article.dateDisplay}</time>
              <h3 class="text-lg font-bold text-[var(--color-ink)] mt-2 mb-2 group-hover:text-[var(--color-indigo)] transition-colors line-clamp-2">
                {article.title}
              </h3>
              <p class="text-sm text-[var(--color-ink-light)] line-clamp-2">{article.description}</p>
              <span class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-[var(--color-indigo)]">
                Read More
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Upcoming Events -->
  <section class="section bg-[var(--color-cream)]">
    <div class="container">
      <SectionHeading title="Upcoming Events" subtitle="Mark your calendar for these exciting upcoming events." />

      <div class="max-w-3xl mx-auto space-y-4" data-animate="stagger">
        {events.map((event) => (
          <div class="card p-6 flex flex-col sm:flex-row items-start gap-5">
            <div class="text-center shrink-0 w-20 py-3 rounded-xl bg-gradient-to-br from-[var(--color-indigo)] to-[var(--color-indigo-deep)]">
              <span class="block text-xs text-white/70 font-medium uppercase">{event.date.split(' ')[0]}</span>
              <span class="block text-2xl font-bold text-white leading-tight">
                {event.date.includes('–') ? event.date.split(' ').slice(1).join(' ') : event.date.split(' ').slice(1).join(' ')}
              </span>
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <h3 class="font-bold text-[var(--color-ink)]">{event.title}</h3>
                <span class:list={['badge text-[10px]', categoryColors[event.category] || 'badge-indigo']}>{event.category}</span>
              </div>
              <div class="flex flex-wrap items-center gap-4 mt-2 text-sm text-[var(--color-ink-light)]">
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4 text-[var(--color-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {event.time}
                </span>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4 text-[var(--color-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {event.venue}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

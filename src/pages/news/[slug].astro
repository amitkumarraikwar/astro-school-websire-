---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news', ({ data }) => data.published);
  return newsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mppublicschool.online/' },
    { '@type': 'ListItem', position: 2, name: 'News & Events', item: 'https://mppublicschool.online/news' },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `https://mppublicschool.online/news/${entry.id}` },
  ],
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'M.P. Public School, Indore',
  },
  publisher: {
    '@type': 'Organization',
    name: 'M.P. Public School, Indore',
    logo: {
      '@type': 'ImageObject',
      url: 'https://mppublicschool.online/Mppublic_logo.jpeg',
    },
  },
};

const formattedDate = entry.data.date.toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryColors: Record<string, string> = {
  achievement: 'badge-amber',
  announcement: 'badge-indigo',
  event: 'badge-red',
  general: 'bg-[var(--color-gray-200)] text-[var(--color-ink)]',
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  jsonLd={[breadcrumbLd, articleLd]}
>
  <!-- Article Hero -->
  <section class="gradient-hero py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="container relative">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/60">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li><a href="/news" class="hover:text-white transition-colors">News & Events</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-white font-medium line-clamp-1">{entry.data.title}</li>
        </ol>
      </nav>
      <div class="flex items-center gap-3 mb-4">
        <span class:list={['badge', categoryColors[entry.data.category] || 'badge-indigo']}>{entry.data.category}</span>
        <time class="text-sm text-white/70" datetime={entry.data.date.toISOString()}>{formattedDate}</time>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 max-w-4xl">{entry.data.title}</h1>
      <p class="text-lg text-white/75 max-w-2xl">{entry.data.description}</p>
    </div>
  </section>

  <!-- Article Content -->
  <article class="section bg-white">
    <div class="container container-sm">
      <div class="prose max-w-none">
        <Content />
      </div>

      <!-- Share & Back -->
      <div class="mt-12 pt-8 border-t border-[var(--color-gray-200)] flex items-center justify-between">
        <a href="/news" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-indigo)] hover:text-[var(--color-indigo-deep)] transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Back to News & Events
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

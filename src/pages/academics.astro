---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import AdmissionCTA from '@/components/sections/AdmissionCTA.astro';
import { siteConfig } from '@/config/site';
import { getBreadcrumbList } from '@/lib/schema';
const levels = [
  { title: 'Pre-Primary', classes: 'Pre-Nursery, Nursery, K.G. I, K.G. II', description: 'The school diary lists early learning in English, Hindi, Mathematics, General Knowledge, drawing, and conversation. Ask the office about class availability and admission age.' },
  { title: 'Primary', classes: 'Classes I–V', description: 'English, Hindi, Mathematics, and Environmental Studies appear in the class-specific examination schedule. Classroom learning is accompanied by arts, music, games, and other school activities.' },
  { title: 'Middle School', classes: 'Classes VI–VIII', description: 'The diary lists English, Hindi, Mathematics, Sanskrit, Science, and Social Studies, along with subject projects and examinations.' },
  { title: 'Secondary', classes: 'Classes IX–X', description: 'Students follow the MP Board curriculum. The school diary includes subject examinations, projects, and practical assessments where applicable.' },
  { title: 'Senior Secondary', classes: 'Classes XI–XII', description: 'Science and Commerce are listed in the school fee schedule. The diary includes science and commerce subjects, practicals, and projects. Confirm the current subject combinations and entry requirements with the office.' },
];
const achievers = [
  { name: 'Ananya Goud', className: 'K.G. I', score: '100%' },
  { name: 'Kavyansh Bhawsar', className: 'K.G. I', score: '100%' },
  { name: 'Risabh dawar', className: 'K.G. I', score: '100%' },
  { name: 'Kiyansh', className: 'K.G. I', score: '99.50%' },
];
const breadcrumbLd = getBreadcrumbList([{ name: 'Home', item: `${siteConfig.url}/` }, { name: 'Academics', item: `${siteConfig.url}/academics` }]);
---

<BaseLayout title="Academics & School Programme" description="Explore M.P. Public School Indore's MP Board classes, Science and Commerce streams, school diary, uniform, and academic calendar." jsonLd={breadcrumbLd}>
  <section class="gradient-hero py-20 md:py-28"><div class="container"><nav aria-label="Breadcrumb" class="mb-6 text-sm text-white/75"><a href="/" class="underline">Home</a> / Academics</nav><h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Academics</h1><p class="text-lg text-white/85 max-w-2xl">MP Board education from early years to Class XII, with subject learning and school activities at each stage.</p></div></section>
  <section class="section bg-white"><div class="container"><SectionHeading title="Academic Levels" subtitle="Class information drawn from the school diary and fee schedule." /><div class="grid md:grid-cols-2 gap-6">{levels.map(level => <div class="card p-8"><span class="badge badge-indigo mb-4">{level.classes}</span><h2 class="text-2xl font-bold mb-3">{level.title}</h2><p class="text-[var(--color-ink-light)] leading-relaxed">{level.description}</p></div>)}</div></div></section>
  <section class="section bg-[var(--color-cream)]"><div class="container grid md:grid-cols-2 gap-8">
    <div class="card p-8 prose"><h2>Uniform and House System</h2><p>The school diary specifies the regular uniform for Monday, Tuesday, Thursday, and Friday, and house dress for Wednesday and Saturday for Classes I–XII.</p><ul><li>Boys: cream half-sleeved shirt with bottle-green trousers; refer to the diary for the full uniform specification.</li><li>Girls: cream half-sleeved shirt with green-check skirt; refer to the diary for the full uniform specification.</li><li>Students wear their school ID card daily.</li><li>Houses: Moon (red), Earth (green), Sky (blue), and Sun (yellow).</li></ul><p>Check the school notice board or ask the office about the prescribed uniform before purchasing.</p></div>
    <div class="card p-8 prose"><h2>Assessment and School Calendar</h2><p>The 2026–27 diary contains periodic tests, quarterly, half-yearly, pre-annual, and annual examination schedules, together with project and practical assessments.</p><p>Dates and examination timings vary by class and may be updated by the school. Follow current school notices and confirm arrangements with the office.</p><Button href={siteConfig.documents.diary} target="_blank">Read School Diary & Calendar (PDF)</Button><p class="text-sm">The PDF also includes school rules and annual result lists for 2025–26.</p></div>
  </div></section>
  <section class="section bg-white"><div class="container"><SectionHeading title="Annual Result Highlights: 2025–26" subtitle="Selected K.G. I results as printed in the school diary, page 5. These are individual results, not a school-wide pass rate." /><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">{achievers.map(student => <div class="card p-6 text-center"><h2 class="font-bold">{student.name}</h2><p class="text-sm text-[var(--color-ink-light)] mt-1">{student.className}</p><p class="text-3xl font-bold text-[var(--color-indigo)] mt-3">{student.score}</p></div>)}</div><p class="text-center text-sm mt-6"><a href={`${siteConfig.documents.diary}#page=5`} target="_blank" rel="noopener noreferrer" class="underline">View the school-published result list (PDF)</a></p></div></section>
  <AdmissionCTA />
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InquiryForm from '@/components/sections/InquiryForm.astro';
import { siteConfig } from '@/config/site';
import { getBreadcrumbList } from '@/lib/schema';
const breadcrumbLd = getBreadcrumbList([{ name: 'Home', item: `${siteConfig.url}/` }, { name: 'Contact', item: `${siteConfig.url}/contact` }]);
---

<BaseLayout title="Contact the School" description={`Contact ${siteConfig.name} at ${siteConfig.address}. Call ${siteConfig.phones[0]}, email ${siteConfig.email}, or send an enquiry.`} pageType="ContactPage" jsonLd={breadcrumbLd}>
  <section class="gradient-hero py-20 md:py-28">
    <div class="container">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-white/75"><a href="/" class="underline">Home</a> / Contact</nav>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Contact the School</h1>
      <p class="text-lg text-white/85 max-w-2xl">Ask about admissions, class timings, fees, or a visit to M.P. Public School, Indore.</p>
    </div>
  </section>
  <section class="section bg-white">
    <div class="container grid lg:grid-cols-5 gap-12">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold mb-6">School Office</h2>
        <address class="not-italic space-y-6 text-[var(--color-ink-light)]">
          <div><h3 class="font-semibold text-[var(--color-ink)] mb-2">Main campus</h3><p>{siteConfig.fullName}<br />{siteConfig.address}</p><a href={siteConfig.directionsUrl} target="_blank" rel="noopener noreferrer" class="underline text-[var(--color-indigo)]">Find the school on Google Maps</a></div>
          <div><h3 class="font-semibold text-[var(--color-ink)] mb-2">Call us</h3>{siteConfig.phones.map(phone => <a class="block underline mb-1" href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>)}</div>
          <div><h3 class="font-semibold text-[var(--color-ink)] mb-2">Email</h3><a class="underline break-all" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></div>
          <div><h3 class="font-semibold text-[var(--color-ink)] mb-2">Office hours</h3><p>{siteConfig.workingHours}</p><p class="text-sm mt-1">Please call to confirm office availability before visiting. Class and examination timings differ from office hours.</p></div>
          <div><h3 class="font-semibold text-[var(--color-ink)] mb-2">Junior branch</h3><p>{siteConfig.juniorBranch.name}<br />{siteConfig.juniorBranch.address}</p></div>
        </address>
        <a href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent('Hello, I have an enquiry about M.P. Public School, Indore.')}`} target="_blank" rel="noopener noreferrer" class="inline-flex mt-8 px-6 py-3 rounded-xl bg-[#16783a] text-white font-semibold">Enquire on WhatsApp</a>
        <p class="text-sm text-[var(--color-ink-light)] mt-6">For concerns about website information, privacy, payments, or an admission enquiry, email the office with a brief description and a contact number. Please do not send payment card details or identity-document numbers.</p>
      </div>
      <div class="lg:col-span-3"><h2 class="text-2xl font-bold mb-6">Send an Enquiry</h2><InquiryForm kind="contact" /></div>
    </div>
  </section>
  <section class="bg-[var(--color-cream)] py-12">
    <div class="container">
      <h2 class="text-2xl font-bold mb-6">Find Our Campus</h2>
      <iframe src={siteConfig.mapUrl} width="100%" height="400" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`${siteConfig.name} on Google Maps`} class="rounded-2xl w-full"></iframe>
      <p class="text-sm mt-4 text-[var(--color-ink-light)]">This map searches for the school address. Call the office to confirm the entrance and directions.</p>
    </div>
  </section>
</BaseLayout>

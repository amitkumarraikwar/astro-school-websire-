---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/config/site';
import { getBreadcrumbList } from '@/lib/schema';

const breadcrumbLd = getBreadcrumbList([
  { name: 'Home', item: 'https://mppublicschool.online/' },
  { name: 'Contact Us', item: 'https://mppublicschool.online/contact' },
]);

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${siteConfig.name}`,
  url: 'https://mppublicschool.online/contact',
};

const contactInfo = [
  {
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
    title: 'Address',
    content: siteConfig.address,
    link: 'https://maps.google.com/?q=22.7196,75.8577',
  },
  {
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
    title: 'Phone',
    content: siteConfig.phones.join(', '),
    link: `tel:${siteConfig.phones[0].replace(/\s/g, '')}`,
  },
  {
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    title: 'Email',
    content: siteConfig.email,
    link: `mailto:${siteConfig.email}`,
  },
  {
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Working Hours',
    content: siteConfig.workingHours + '\nSunday: Closed',
    link: null,
  },
];
---

<BaseLayout
  title="Contact Us – Get in Touch"
  description={`Contact ${siteConfig.name} for admissions, general inquiries, or campus visits. Call ${siteConfig.phones[0]} or email ${siteConfig.email}.`}
  pageType="ContactPage"
  jsonLd={[breadcrumbLd, contactLd]}
>
  <!-- Page Hero -->
  <section class="gradient-hero py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="container relative">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/60">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-white font-medium">Contact Us</li>
        </ol>
      </nav>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">Contact Us</h1>
      <p class="text-lg text-white/75 max-w-2xl mb-4">We'd love to hear from you. Reach out for admissions, inquiries, or to schedule a campus visit at M.P. Public School, Indore.</p>
      
      <!-- AEO Quick Answer -->
      <p class="text-lg text-white/90 max-w-3xl bg-white/10 p-4 rounded-xl border border-white/20 backdrop-blur">
        <strong>Quick Answer:</strong> You can contact {siteConfig.name} via phone at {siteConfig.phones[0]} or email at {siteConfig.email}. Our campus is located at {siteConfig.address}, and our working hours are {siteConfig.workingHours}.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-5 gap-10 lg:gap-16">
        <!-- Contact Info -->
        <div class="lg:col-span-2" data-animate="fade-up">
          <h2 class="text-2xl font-bold text-[var(--color-ink)] mb-6">Get in Touch</h2>

          <div class="space-y-6">
            {contactInfo.map((info) => (
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-[var(--color-indigo)]/8 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-[var(--color-indigo)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    {info.icon.split(' M').map((d, i) => (
                      <path stroke-linecap="round" stroke-linejoin="round" d={i === 0 ? d : `M${d}`} />
                    ))}
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-[var(--color-ink)] text-sm mb-1">{info.title}</h3>
                  {info.link ? (
                    <a href={info.link} class="text-sm text-[var(--color-ink-light)] hover:text-[var(--color-indigo)] transition-colors" target={info.link.startsWith('http') ? '_blank' : undefined} rel={info.link.startsWith('http') ? 'noopener noreferrer' : undefined}>
                      {info.content}
                    </a>
                  ) : (
                    <p class="text-sm text-[var(--color-ink-light)] whitespace-pre-line">{info.content}</p>
                  )}
                </div>
              </div>
            ))}
          </div>

          <!-- WhatsApp -->
          <div class="mt-8">
            <a
              href="https://wa.me/917312345678?text=Hello%2C%20I%20would%20like%20to%20know%20more%20about%20M.P.%20Public%20School."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-6 py-3 rounded-xl bg-[#25D366] text-white font-semibold text-sm hover:bg-[#20BA5A] transition-colors shadow-lg"
            >
              <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              Chat on WhatsApp
            </a>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-3" data-animate="fade-up">
          <div class="card p-8">
            <h2 class="text-2xl font-bold text-[var(--color-ink)] mb-6">Send Us a Message</h2>

            <form action="#" method="POST" class="space-y-6" novalidate id="contact-form">
              <!-- Honeypot -->
              <div class="hidden" aria-hidden="true">
                <label for="hp-website">Website</label>
                <input type="text" id="hp-website" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <div class="grid sm:grid-cols-2 gap-6">
                <div>
                  <label for="contact-name" class="block text-sm font-medium text-[var(--color-ink)] mb-2">Full Name *</label>
                  <input type="text" id="contact-name" name="name" required class="w-full px-4 py-4 rounded-xl border border-[var(--color-gray-300)] focus:border-[var(--color-indigo)] focus:ring-2 focus:ring-[var(--color-indigo)]/20 outline-none transition-colors text-base" placeholder="Your full name" />
                </div>
                <div>
                  <label for="contact-phone" class="block text-sm font-medium text-[var(--color-ink)] mb-2">Phone Number *</label>
                  <input type="tel" id="contact-phone" name="phone" required class="w-full px-4 py-4 rounded-xl border border-[var(--color-gray-300)] focus:border-[var(--color-indigo)] focus:ring-2 focus:ring-[var(--color-indigo)]/20 outline-none transition-colors text-base" placeholder="+91 XXXXX XXXXX" />
                </div>
              </div>

              <div>
                <label for="contact-email" class="block text-sm font-medium text-[var(--color-ink)] mb-2">Email Address *</label>
                <input type="email" id="contact-email" name="email" required class="w-full px-4 py-4 rounded-xl border border-[var(--color-gray-300)] focus:border-[var(--color-indigo)] focus:ring-2 focus:ring-[var(--color-indigo)]/20 outline-none transition-colors text-base" placeholder="your@email.com" />
              </div>

              <div>
                <label for="contact-message" class="block text-sm font-medium text-[var(--color-ink)] mb-2">Message *</label>
                <textarea id="contact-message" name="message" rows="5" required class="w-full px-4 py-4 rounded-xl border border-[var(--color-gray-300)] focus:border-[var(--color-indigo)] focus:ring-2 focus:ring-[var(--color-indigo)]/20 outline-none transition-colors text-base resize-none" placeholder="How can we help you?"></textarea>
              </div>

              <Button variant="primary" size="lg" type="submit" fullWidth={true}>
                Send Message
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </Button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="bg-[var(--color-cream)] py-12">
    <div class="container">
      <div class="rounded-2xl overflow-hidden shadow-lg" data-animate="fade-up">
        <iframe
          src={siteConfig.mapUrl}
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`${siteConfig.name} Location on Google Maps`}
          class="w-full"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Basic form validation
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // Check honeypot
    const honeypot = form.querySelector('[name="website"]') as HTMLInputElement;
    if (honeypot?.value) return;

    // Basic validation
    const name = (form.querySelector('#contact-name') as HTMLInputElement)?.value.trim();
    const phone = (form.querySelector('#contact-phone') as HTMLInputElement)?.value.trim();
    const email = (form.querySelector('#contact-email') as HTMLInputElement)?.value.trim();
    const message = (form.querySelector('#contact-message') as HTMLTextAreaElement)?.value.trim();

    if (!name || !phone || !email || !message) {
      alert('Please fill in all required fields.');
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      alert('Please enter a valid email address.');
      return;
    }

    // Success (replace with actual form submission)
    alert('Thank you for your message! We will get back to you within 24 hours.');
    form.reset();
  });
</script>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Stats from '@/components/sections/Stats.astro';
import AboutPreview from '@/components/sections/AboutPreview.astro';
import WhyChooseUs from '@/components/sections/WhyChooseUs.astro';
import DirectorMessage from '@/components/sections/DirectorMessage.astro';
import PrincipalMessage from '@/components/sections/PrincipalMessage.astro';
import FacilitiesPreview from '@/components/sections/FacilitiesPreview.astro';
import NewsEventsPreview from '@/components/sections/NewsEventsPreview.astro';
import EventMediaPreview from '@/components/sections/EventMediaPreview.astro';
import AdmissionCTA from '@/components/sections/AdmissionCTA.astro';
import MapSection from '@/components/sections/MapSection.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getBreadcrumbList } from '@/lib/schema';
import { siteConfig } from '@/config/site';

const breadcrumbLd = getBreadcrumbList([
  { name: 'Home', item: 'https://mppublicschool.online/' }
]);

const homeFaqs = [
  { question: `Where is ${siteConfig.name} located?`, answer: `We are located at ${siteConfig.address}.` },
  { question: "Which board is the school affiliated to?", answer: `The school is affiliated with MP Board (Affiliation No: ${siteConfig.affiliationNumber}).` },
  { question: "What classes does the school offer?", answer: "We offer classes from Pre-Primary up to Senior Secondary (Class 12)." },
  { question: "What are the office hours?", answer: `${siteConfig.workingHours}. Class timings vary. Please call before visiting and confirm your child's timetable with the office.` },
  { question: "How is transport arranged?", answer: "Parents contact vehicle operators directly and pay transport charges separately. Ask the office about available operators and routes." }
];
---

<BaseLayout
  title="M.P. Public School, Indore"
  description="M.P. Public School, Ashok Nagar, Indore. MP Board affiliation no. 532414. Explore classes, school facilities, admission information, fees, and office contacts."
  jsonLd={breadcrumbLd}
>
  <Hero />
  <Stats />
  <AboutPreview />
  <WhyChooseUs />
  <DirectorMessage />
  <PrincipalMessage />
  <FacilitiesPreview />
  <NewsEventsPreview />
  <EventMediaPreview />
  
  <section class="section bg-white">
    <div class="container">
      <SectionHeading 
        title="Frequently Asked Questions" 
        subtitle="Common queries about admissions, facilities, and academics at M.P. Public School."
      />
      <FAQAccordion faqs={homeFaqs} />
    </div>
  </section>

  <AdmissionCTA />
  <MapSection />
</BaseLayout>

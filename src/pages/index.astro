---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Stats from '@/components/sections/Stats.astro';
import AboutPreview from '@/components/sections/AboutPreview.astro';
import WhyChooseUs from '@/components/sections/WhyChooseUs.astro';
import DirectorMessage from '@/components/sections/DirectorMessage.astro';
import PrincipalMessage from '@/components/sections/PrincipalMessage.astro';
import FacilitiesPreview from '@/components/sections/FacilitiesPreview.astro';
import NewsEventsPreview from '@/components/sections/NewsEventsPreview.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import AdmissionCTA from '@/components/sections/AdmissionCTA.astro';
import MapSection from '@/components/sections/MapSection.astro';
import FAQAccordion from '@/components/ui/FAQAccordion.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getBreadcrumbList } from '@/lib/schema';
import { siteConfig } from '@/config/site';

const breadcrumbLd = getBreadcrumbList([
  { name: 'Home', item: 'https://mppublicschool.online/' }
]);

const homeFaqs = [
  { question: `Where is ${siteConfig.name} located?`, answer: `We are located at ${siteConfig.address}.` },
  { question: "Which board is the school affiliated to?", answer: `The school is affiliated with MP Board (Affiliation No: ${siteConfig.affiliationNumber}).` },
  { question: "What classes does the school offer?", answer: "We offer classes from Pre-Primary up to Senior Secondary (Class 12)." },
  { question: "What are the school timings?", answer: `Our standard working hours are ${siteConfig.workingHours}.` },
  { question: "Is transport facility available?", answer: "Yes, we provide safe and secure bus transport covering major routes across the city." }
];
---

<BaseLayout
  title="M.P. Public School, Indore"
  description="M.P. Public School is a premier MP Board-affiliated school in Indore, Madhya Pradesh. Offering quality education from Pre-Primary to Senior Secondary with modern facilities and 30+ years of excellence."
  jsonLd={breadcrumbLd}
>
  <Hero />
  <Stats />
  <AboutPreview />
  <WhyChooseUs />
  <DirectorMessage />
  <PrincipalMessage />
  <FacilitiesPreview />
  <NewsEventsPreview />
  <Testimonials />
  
  <section class="section bg-white">
    <div class="container">
      <SectionHeading 
        title="Frequently Asked Questions" 
        subtitle="Common queries about admissions, facilities, and academics at M.P. Public School."
      />
      <FAQAccordion faqs={homeFaqs} />
    </div>
  </section>

  <AdmissionCTA />
  <MapSection />
</BaseLayout>

  { name: 'Sonal Bhadauriya', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Isha Thakur', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Sheetal Jain', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Meeta Jain', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Kunal Khede', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Chinki Jain', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Monika Gehlot', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Shivani Nagle', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Varsha Singhal', designation: 'Social Media', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Ruchita Shrivastav', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Pranav Bhatnagar', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Rama Rathi', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Nikita Verma', designation: 'Office Staff', department: 'Administration', qualification: '', bio: '' },
  { name: 'Rinki Khilari', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },

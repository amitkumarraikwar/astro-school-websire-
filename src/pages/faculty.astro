  { name: 'Pinki Choudhary', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Dharmendra Kamal', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Meenakshi Bhatt', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Kavita Thakur', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Mamta Mandpe', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Meenakshi Singh', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },
  { name: 'Meena Sharma', designation: 'Teacher', department: 'Teaching Staff', qualification: '', bio: '' },

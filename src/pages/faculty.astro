---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdmissionCTA from '@/components/sections/AdmissionCTA.astro';
import { getBreadcrumbList } from '@/lib/schema';
import { siteConfig } from '@/config/site';
import { getCollection } from 'astro:content';

const staff = await getCollection('faculty');
const optimizeStaffPhoto = (photo?: string) => photo
  ?.replace('/STAFF_FINAL_PICS_PRO_HD_ENHANCED/', '/STAFF_FINAL_PICS_OPTIMIZED/')
  .replace(/\.jpg$/i, '.webp');

const getPhoto = (name: string) => {
  const photo = staff.find(({ data }) => data.name === name)?.data.photo;
  return optimizeStaffPhoto(photo);
};

const existingFaculty = [
  { name: 'Dilip Budhani', designation: 'Director', department: 'Administration', qualification: '', bio: 'Leading the vision and strategy of M.P. Public School.' },
  { name: 'Shraddha Pardeshi', designation: 'Principal', department: 'Administration', qualification: 'MSc. (B.Ed)', bio: 'Ensuring holistic development and academic excellence.' },

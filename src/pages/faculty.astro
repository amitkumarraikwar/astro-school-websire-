  { name: 'Vidhya Khare', designation: 'Housekeeping Staff', department: 'Support Staff', qualification: '', bio: '' },
  { name: 'Diksha Pawar', designation: 'Housekeeping Staff', department: 'Support Staff', qualification: '', bio: '' },
  { name: 'Pooja', designation: 'Sweeper', department: 'Support Staff', qualification: '', bio: '' },
];

const faculty = [
  ...existingFaculty.map((member) => ({ ...member, photo: getPhoto(member.name) })),
  ...staff
    .filter(({ data }) => data.photo && ['Alka Chaurasiya', 'Pooja Sharma'].includes(data.name))
    .sort((a, b) => a.data.order - b.data.order)
    .map(({ data }) => ({ ...data, photo: optimizeStaffPhoto(data.photo) })),
];

const departments = [...new Set(faculty.map(f => f.department))];

const breadcrumbLd = getBreadcrumbList([
  { name: 'Home', item: `${siteConfig.url}/` },
  { name: 'Faculty & Staff', item: `${siteConfig.url}/faculty` },
]);
---

<BaseLayout
  title="Faculty & Staff Information"
  description="Meet the teaching, administration and support staff of M.P. Public School, Indore."
  jsonLd={breadcrumbLd}
>
  <!-- Page Hero -->
  <section class="gradient-hero py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="container relative">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/60">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-white font-medium">Faculty & Staff</li>
        </ol>
      </nav>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">Our Faculty & Staff</h1>
       <p class="text-lg text-white/75 max-w-2xl mb-4">Our teaching, administration and support staff.</p>
      
      <!-- AEO Quick Answer -->
      <p class="text-lg text-white/90 max-w-3xl bg-white/10 p-4 rounded-xl border border-white/20 backdrop-blur">
          Contact the office for current class, subject and role assignments.
      </p>
    </div>
  </section>

  <!-- Filter + Faculty Grid -->
  <section class="section bg-white">
    <div class="container">
      <!-- Filter buttons -->
       <div class="flex flex-wrap justify-center gap-2 mb-3" id="faculty-filter" data-animate="fade-up" role="group" aria-label="Filter faculty and staff by department">
         <button type="button" aria-pressed="true" class="filter-btn active px-4 py-2 rounded-xl text-sm font-medium bg-[var(--color-indigo)] text-white transition-all duration-200" data-filter="all">
           All Departments
         </button>
         {departments.map((dept) => (
           <button type="button" aria-pressed="false" class="filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-[var(--color-gray-100)] text-[var(--color-ink-light)] hover:bg-[var(--color-indigo)]/10 hover:text-[var(--color-indigo)] transition-all duration-200" data-filter={dept}>
             {dept}
           </button>
         ))}
       </div>
       <p id="faculty-filter-status" class="text-center text-sm text-[var(--color-ink-light)] mb-10" aria-live="polite">Showing all {faculty.length} faculty and staff members.</p>

      <!-- Faculty Grid -->
      <div class="snap-container md:grid-cols-3 lg:grid-cols-4 gap-6" id="faculty-grid" data-animate="stagger" role="region" aria-label="School faculty and staff" tabindex="0">
        {faculty.map((member) => (
          <div class="card p-6 text-center faculty-card snap-card" data-department={member.department}>
            <!-- Staff without a portrait keep an initials avatar. -->
            <div class="w-28 h-28 mx-auto mb-4 rounded-full bg-gradient-to-br from-[var(--color-indigo)] to-[var(--color-indigo-deep)] flex items-center justify-center shadow-lg overflow-hidden ring-4 ring-[var(--color-indigo)]/10">
              {member.photo ? (
                <img src={member.photo} alt={`${member.name}, ${member.designation}`} width="224" height="224" loading="lazy" decoding="async" class="w-full h-full object-cover object-top" />
              ) : (
                <span class="text-2xl font-bold text-white">{member.name.charAt(0)}{member.name.split(' ').pop()?.charAt(0)}</span>
              )}
            </div>
            <h3 class="text-base font-bold text-[var(--color-ink)] mb-1">{member.name}</h3>
            <p class="text-sm font-medium text-[var(--color-indigo)] mb-1">{member.designation}</p>
            <p class="text-xs text-[var(--color-ink-light)] mb-3">{member.qualification}</p>
            <p class="text-xs text-[var(--color-gray-500)] leading-relaxed">{member.bio}</p>
            <div class="mt-3">
              <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-indigo)]/8 text-xs font-medium text-[var(--color-indigo)]">
                {member.department}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <AdmissionCTA />
</BaseLayout>

<script>
  // Faculty filter functionality
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const facultyCards = Array.from(document.querySelectorAll<HTMLElement>('.faculty-card'));
  const status = document.getElementById('faculty-filter-status');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Update active state
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-[var(--color-indigo)]', 'text-white');
        b.classList.add('bg-[var(--color-gray-100)]', 'text-[var(--color-ink-light)]');
        b.setAttribute('aria-pressed', String(b === btn));
      });
      btn.classList.add('active', 'bg-[var(--color-indigo)]', 'text-white');
      btn.classList.remove('bg-[var(--color-gray-100)]', 'text-[var(--color-ink-light)]');

      const filter = btn.getAttribute('data-filter');

      let visibleCount = 0;
      facultyCards.forEach((card) => {
        const dept = card.getAttribute('data-department');
        const isVisible = filter === 'all' || dept === filter;
        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (status) {
        status.textContent = filter === 'all'
          ? `Showing all ${visibleCount} faculty and staff members.`
          : `Showing ${visibleCount} ${filter} members.`;
      }
    });
  });
</script>

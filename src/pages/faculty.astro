---

<BaseLayout
  title="Faculty & Staff – Our Educators"
  description="Meet the dedicated and qualified faculty of M.P. Public School Indore. Over 120 experienced educators committed to academic excellence and student development."
  jsonLd={breadcrumbLd}
>
  <!-- Page Hero -->
  <section class="gradient-hero py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="container relative">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/60">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-white font-medium">Faculty & Staff</li>
        </ol>
      </nav>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">Our Faculty & Staff</h1>
      <p class="text-lg text-white/75 max-w-2xl mb-4">Meet the dedicated educators who inspire, guide, and nurture every student at M.P. Public School, Indore.</p>
      
      <!-- AEO Quick Answer -->
      <p class="text-lg text-white/90 max-w-3xl bg-white/10 p-4 rounded-xl border border-white/20 backdrop-blur">
        <strong>Quick Answer:</strong> The faculty at {siteConfig.name} comprises over {siteConfig.stats.teachers} highly qualified and experienced educators dedicated to delivering the MP Board curriculum through innovative and student-centric teaching methodologies.
      </p>
    </div>
  </section>

  <!-- Filter + Faculty Grid -->
  <section class="section bg-white">
    <div class="container">
      <!-- Filter buttons -->
      <div class="flex flex-wrap justify-center gap-2 mb-12" id="faculty-filter" data-animate="fade-up">
        <button class="filter-btn active px-4 py-2 rounded-xl text-sm font-medium bg-[var(--color-indigo)] text-white transition-all duration-200" data-filter="all">
          All Departments
        </button>
        {departments.map((dept) => (
          <button class="filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-[var(--color-gray-100)] text-[var(--color-ink-light)] hover:bg-[var(--color-indigo)]/10 hover:text-[var(--color-indigo)] transition-all duration-200" data-filter={dept}>
            {dept}
          </button>
        ))}
      </div>

      <!-- Faculty Grid -->
      <div class="snap-container gap-6" id="faculty-grid" data-animate="stagger">
        {faculty.map((member) => (
          <div class="card p-6 text-center faculty-card snap-card" data-department={member.department}>
            <!-- Avatar -->
            <div class="w-24 h-24 mx-auto mb-4 rounded-full bg-gradient-to-br from-[var(--color-indigo)] to-[var(--color-indigo-deep)] flex items-center justify-center shadow-lg">
              <span class="text-2xl font-bold text-white">{member.name.charAt(0)}{member.name.split(' ').pop()?.charAt(0)}</span>
            </div>
            <h3 class="text-base font-bold text-[var(--color-ink)] mb-1">{member.name}</h3>
            <p class="text-sm font-medium text-[var(--color-indigo)] mb-1">{member.designation}</p>
            <p class="text-xs text-[var(--color-ink-light)] mb-3">{member.qualification}</p>
            <p class="text-xs text-[var(--color-gray-500)] leading-relaxed">{member.bio}</p>
            <div class="mt-3">
              <span class="inline-block px-3 py-1 rounded-full bg-[var(--color-indigo)]/8 text-xs font-medium text-[var(--color-indigo)]">
                {member.department}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <AdmissionCTA />
</BaseLayout>

<script>
  // Faculty filter functionality
  const filterBtns = document.querySelectorAll('.filter-btn');
  const facultyCards = document.querySelectorAll('.faculty-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Update active state
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-[var(--color-indigo)]', 'text-white');
        b.classList.add('bg-[var(--color-gray-100)]', 'text-[var(--color-ink-light)]');
      });
      btn.classList.add('active', 'bg-[var(--color-indigo)]', 'text-white');
      btn.classList.remove('bg-[var(--color-gray-100)]', 'text-[var(--color-ink-light)]');

      const filter = btn.getAttribute('data-filter');

      facultyCards.forEach((card) => {
        const dept = card.getAttribute('data-department');
        if (filter === 'all' || dept === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

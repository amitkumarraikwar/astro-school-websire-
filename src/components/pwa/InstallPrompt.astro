---
import { X } from 'lucide-astro';
---

<div id="pwa-install-prompt" class="fixed bottom-[84px] left-4 right-4 z-[200] bg-white rounded-2xl shadow-[0_10px_40px_rgba(0,0,0,0.2)] p-4 transform translate-y-[150%] transition-transform duration-500 ease-out flex items-center justify-between opacity-0 invisible" aria-hidden="true">
  <div class="flex items-center gap-4">
    <img src="/Mppublic_logo.jpeg" alt="MP School App Icon" width="48" height="48" class="w-12 h-12 rounded-xl shadow-sm border border-[var(--color-gray-100)]" />
    <div>
      <h3 class="text-sm font-bold text-[var(--color-ink)] leading-tight">Install MP School App</h3>
      <p class="text-xs text-[var(--color-ink-light)] mt-0.5">Add the school website to your home screen</p>
    </div>
  </div>
  
  <div class="flex items-center gap-2">
    <button id="pwa-install-close" class="p-2 text-[var(--color-gray-400)] hover:text-[var(--color-ink)] active:scale-95" aria-label="Dismiss">
      <X class="w-5 h-5" />
    </button>
    <button id="pwa-install-btn" class="px-4 py-2 bg-[var(--color-indigo)] text-white text-sm font-bold rounded-xl active:scale-95 transition-transform shadow-md">
      Install
    </button>
  </div>
</div>

<script>
  let deferredPrompt: any = null;
  const PROMPT_DELAY = 20000; // 20 seconds
  const STORAGE_KEY = 'pwa_prompt_dismissed';
  const DISMISS_DURATION = 14 * 24 * 60 * 60 * 1000; // 14 days

  function initInstallPrompt() {
    const promptEl = document.getElementById('pwa-install-prompt');
    const installBtn = document.getElementById('pwa-install-btn');
    const closeBtn = document.getElementById('pwa-install-close');
    
    if (!promptEl || !installBtn || !closeBtn) return;

    // Check if running in standalone mode (already installed)
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || ('standalone' in window.navigator && (window.navigator as any).standalone === true);
    if (isStandalone) return;

    // Check if dismissed recently
    let dismissedAt: string | null = null;
    try { dismissedAt = localStorage.getItem(STORAGE_KEY); } catch { /* Storage may be unavailable. */ }
    if (dismissedAt && Date.now() - parseInt(dismissedAt) < DISMISS_DURATION) return;

    // Listen for install prompt event
    window.addEventListener('beforeinstallprompt', (e) => {
      // Prevent Chrome <= 67 from automatically showing the prompt
      e.preventDefault();
      deferredPrompt = e;

      // Show our custom UI after delay
      setTimeout(() => {
        if (deferredPrompt) {
          promptEl.classList.remove('invisible', 'opacity-0', 'translate-y-[150%]');
          promptEl.setAttribute('aria-hidden', 'false');
        }
      }, PROMPT_DELAY);
    });

    installBtn.addEventListener('click', async () => {
      promptEl.classList.add('translate-y-[150%]', 'opacity-0');
      promptEl.setAttribute('aria-hidden', 'true');
      
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          console.log('User accepted the A2HS prompt');
        }
        deferredPrompt = null;
      }
    });

    closeBtn.addEventListener('click', () => {
      promptEl.classList.add('translate-y-[150%]', 'opacity-0');
      promptEl.setAttribute('aria-hidden', 'true');
      try { localStorage.setItem(STORAGE_KEY, Date.now().toString()); } catch { /* Dismissal still works without storage. */ }
      setTimeout(() => promptEl.classList.add('invisible'), 500);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initInstallPrompt, { once: true });
  else initInstallPrompt();
</script>

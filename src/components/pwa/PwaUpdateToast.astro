---
import { RefreshCw } from 'lucide-react';
---

<div id="pwa-update-toast" class="fixed top-4 left-1/2 -translate-x-1/2 z-[300] bg-[var(--color-indigo)] text-white px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 transform -translate-y-[150%] transition-transform duration-300 opacity-0 invisible">
  <RefreshCw class="w-5 h-5 text-[var(--color-amber)]" />
  <span class="text-sm font-medium">New version available!</span>
  <button id="pwa-update-btn" class="ml-2 px-3 py-1.5 bg-white/20 hover:bg-white/30 rounded-lg text-sm font-bold active:scale-95 transition-all">
    Refresh
  </button>
</div>

<script>
  document.addEventListener('astro:page-load', async () => {
    // Only run if service workers are supported
    if (!('serviceWorker' in navigator)) return;

    try {
      // Import workbox-window dynamically
      const { Workbox } = await import('workbox-window');
      
      const wb = new Workbox('/sw.js');
      const toast = document.getElementById('pwa-update-toast');
      const updateBtn = document.getElementById('pwa-update-btn');

      if (!toast || !updateBtn) return;

      const showToast = () => {
        toast.classList.remove('invisible', 'opacity-0', '-translate-y-[150%]');
      };

      // Add event listeners to handle the update
      wb.addEventListener('waiting', showToast);
      wb.addEventListener('externalwaiting', showToast);

      updateBtn.addEventListener('click', () => {
        wb.addEventListener('controlling', () => {
          window.location.reload();
        });
        wb.messageSkipWaiting();
      });

      wb.register();
    } catch (e) {
      console.warn('Workbox failed to load:', e);
    }
  });
</script>

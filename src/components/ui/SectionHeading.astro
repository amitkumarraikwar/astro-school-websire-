---
export interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  light?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  align = 'center',
  light = false,
  class: className = '',
} = Astro.props;
---

<div class:list={[
  'mb-12 md:mb-16',
  align === 'center' ? 'text-center' : 'text-left',
  className,
]} data-animate="fade-up">
  <!-- Decorative accent line -->
  <div class:list={[
    'mb-4 flex items-center gap-3',
    align === 'center' ? 'justify-center' : '',
  ]}>
    <span class:list={[
      'block h-1 w-12 rounded-full',
      light ? 'bg-[var(--color-amber)]' : 'bg-[var(--color-amber)]',
    ]}></span>
    <span class:list={[
      'block h-1 w-4 rounded-full',
      light ? 'bg-white/40' : 'bg-[var(--color-indigo)]/30',
    ]}></span>
  </div>

  <h2 class:list={[
    'text-3xl md:text-4xl lg:text-5xl font-bold leading-tight',
    light ? 'text-white' : 'text-[var(--color-ink)]',
  ]}>
    {title}
  </h2>

  {subtitle && (
    <p class:list={[
      'mt-4 max-w-2xl text-lg',
      align === 'center' ? 'mx-auto' : '',
      light ? 'text-white/80' : 'text-[var(--color-ink-light)]',
    ]}>
      {subtitle}
    </p>
  )}
</div>

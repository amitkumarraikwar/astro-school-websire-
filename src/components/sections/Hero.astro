---
import Button from '@/components/ui/Button.astro';
import { Image } from 'astro:assets';
import campusImg from '@/assets/images/mpps_front.jpeg';
import { siteConfig } from '@/config/site';

const classImages = Array.from({ length: 8 }, (_, index) => `/classes/classImages${index + 1}.jpeg`);
---

<section class="relative min-h-screen flex items-center overflow-hidden gradient-hero pt-28 pb-16" id="hero">
  <!-- Class and learning images rotate behind the hero content. -->
  <div class="hero-class-background absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
    {classImages.map((image) => <div class="hero-class-slide" style={`background-image: url("${image}");`}></div>)}
  </div>
  <div class="hero-class-overlay absolute inset-0 z-[1] pointer-events-none" aria-hidden="true"></div>

  <!-- Static fallback gradient + decorative elements for prefers-reduced-motion or low-end -->
  <div class="hero-static-bg absolute inset-0 z-[2] pointer-events-none">
    <!-- Decorative circles inspired by logo -->
    <div class="absolute top-[15%] right-[10%] w-32 h-32 md:w-48 md:h-48 rounded-full bg-[var(--color-red)]/15 blur-xl animate-pulse"></div>
    <div class="absolute bottom-[20%] left-[5%] w-24 h-24 md:w-40 md:h-40 rounded-full bg-[var(--color-amber)]/10 blur-xl"></div>
    <div class="absolute top-[40%] left-[60%] w-16 h-16 md:w-24 md:h-24 rounded-full bg-[var(--color-cyan)]/10 blur-lg"></div>

    <!-- Subtle grid pattern -->
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Text -->
      <div class="max-w-3xl">
        <!-- Badge -->
        <div class="inline-flex flex-wrap items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm text-white backdrop-blur border border-white/10 mb-6" data-animate="fade-up">
          <span class="w-2 h-2 rounded-full bg-[var(--color-amber)] animate-pulse shrink-0"></span>
          <span>MP Board · Affiliation No. {siteConfig.affiliationNumber} · Indore</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] text-white mb-6" id="hero-headline">
          Shaping Bright
          <span class="text-[var(--color-yellow)]"> Futures</span>
          <br />
          <span class="text-white">In Indore</span>
        </h1>

        <!-- Subheadline & Quick Answer -->
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85" data-animate="fade-up">
          Welcome to {siteConfig.name}, an MP Board-affiliated school at 9, Ashok Nagar, Indore. Explore Pre-Primary to Class XII education, campus facilities, and admission information. Our office can help you check class availability and fees.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4" data-animate="fade-up">
          <Button variant="primary" size="lg" href="/admissions">
            Admission Information
            <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </Button>
          <Button variant="outline-dark" size="lg" href="/contact">
            <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Book a Campus Visit
          </Button>
        </div>

        <!-- Trust indicators -->
        <div class="mt-10 border-t border-white/15 pt-8 flex flex-wrap gap-6" data-animate="fade-up">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-[var(--color-amber)]/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-[var(--color-amber)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="text-white/70 text-sm">MP Board Affiliated</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-[var(--color-cyan)]/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-[var(--color-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <span class="text-white/70 text-sm">Smart Classrooms</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-[var(--color-red)]/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-[var(--color-red)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
              </svg>
            </div>
            <span class="text-white/70 text-sm">Pre-Primary to Class XII</span>
          </div>
        </div>
      </div>

      <figure class="mt-8 lg:mt-0 overflow-hidden rounded-3xl border border-white/20 shadow-2xl bg-white/10">
        <Image src={campusImg} alt="M.P. Public School building at Ashok Nagar, Indore" widths={[480, 800, 1200]} sizes="(max-width: 1024px) 100vw, 50vw" loading="eager" fetchpriority="high" class="w-full aspect-[4/3] object-cover" />
        <figcaption class="p-5 text-white/85 text-sm">{siteConfig.fullName}<br />{siteConfig.address}</figcaption>
      </figure>
    </div>
  </div>


</section>

<style>
  .hero-class-slide {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    opacity: 0;
    transform: scale(1.04);
    animation: hero-class-fade 56s ease-in-out infinite;
  }

  .hero-class-slide:nth-child(2) { animation-delay: -7s; }
  .hero-class-slide:nth-child(3) { animation-delay: -14s; }
  .hero-class-slide:nth-child(4) { animation-delay: -21s; }
  .hero-class-slide:nth-child(5) { animation-delay: -28s; }
  .hero-class-slide:nth-child(6) { animation-delay: -35s; }
  .hero-class-slide:nth-child(7) { animation-delay: -42s; }
  .hero-class-slide:nth-child(8) { animation-delay: -49s; }

  .hero-class-overlay {
    background: linear-gradient(90deg, rgba(20, 21, 67, 0.96) 0%, rgba(30, 31, 85, 0.86) 44%, rgba(42, 43, 107, 0.58) 100%);
  }

  @keyframes hero-class-fade {
    0%, 10% { opacity: 0; transform: scale(1.04); }
    13%, 25% { opacity: 0.9; transform: scale(1); }
    28%, 100% { opacity: 0; transform: scale(1.04); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-class-slide {
      animation: none !important;
    }

    .hero-class-slide:first-child {
      opacity: 0.9;
      transform: none;
    }

    .hero-class-slide:not(:first-child) {
      display: none;
    }
  }
</style>

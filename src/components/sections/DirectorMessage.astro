---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import directorImg from '@/assets/images/mpps_director.jpeg';
---

<section class="section gradient-indigo relative overflow-hidden" id="director-message">
  <div class="container relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Photo Side (5 cols) -->
      <div class="lg:col-span-5" data-animate="fade-up">
        <div class="relative max-w-md mx-auto lg:mx-0">
          <!-- Frame outline accent -->
          <div class="absolute -inset-3 rounded-3xl bg-gradient-to-tr from-[var(--color-amber)] via-[var(--color-yellow)] to-transparent opacity-30 blur-sm"></div>
          
          <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-[var(--color-indigo-deep)] border border-white/10 aspect-[3/4]">
            <Image 
              src={directorImg} 
              alt="Mr. Dilip Budhani - Director of M.P. Public School Indore" 
              class="w-full h-full object-cover object-top"
              widths={[400, 800]}
              sizes="(max-width: 1024px) 350px, 450px"
              loading="lazy"
            />
          </div>

          <!-- Director Badge Card -->
          <div class="absolute -bottom-6 left-4 right-4 bg-white/95 backdrop-blur-md rounded-2xl shadow-xl p-4 text-center border border-white/20">
            <h3 class="font-bold text-xl text-[var(--color-ink)]">Mr. Dilip Budhani</h3>
            <p class="text-sm font-semibold text-[var(--color-indigo)] uppercase tracking-wider mt-0.5">Director, M.P. Public School</p>
          </div>
        </div>
      </div>

      <!-- Message Side (7 cols) -->
      <div class="lg:col-span-7 pt-6 lg:pt-0" data-animate="fade-up">
        <SectionHeading
          title="School leadership"
          subtitle="A message from our Director."
          align="left"
          light={true}
        />

        <div class="relative pl-6 sm:pl-8 border-l-4 border-[var(--color-amber)] space-y-5">
          <div class="text-white/90 text-lg sm:text-xl font-light leading-relaxed space-y-5">
            <p>
              Mr. Dilip Budhani is the Director of M.P. Public School.
            </p>
            <p class="text-base sm:text-lg text-white/80 font-normal leading-relaxed">
              The school offers MP Board education from Pre-Primary to Class XII at our Ashok Nagar campus, along with music, dance, art and craft, games, sports, yoga, and cultural and literary activities.
            </p>
            <p class="text-base sm:text-lg text-white/80 font-normal leading-relaxed">
              Contact the office for current programme details, class availability, and subject combinations.
            </p>
          </div>

          <div class="pt-4 border-t border-white/10 flex items-center justify-between flex-wrap gap-4">
            <div>
              <p class="font-bold text-white text-lg">Mr. Dilip Budhani</p>
              <p class="text-xs text-[var(--color-amber)] uppercase font-semibold tracking-wider">Director · M.P. Public School, Indore</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

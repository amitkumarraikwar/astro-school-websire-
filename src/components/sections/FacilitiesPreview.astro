---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';

const facilities = [
  { icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z', title: 'Smart Classrooms', desc: 'Interactive whiteboards and digital learning tools in every classroom.' },
  { icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', title: 'Library', desc: '15,000+ books, digital library access, and dedicated reading spaces.' },
  { icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z', title: 'Science Labs', desc: 'Fully equipped Physics, Chemistry, and Biology laboratories.' },
  { icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z', title: 'Sports Complex', desc: 'Cricket ground, basketball court, athletics track, and indoor sports.' },
  { icon: 'M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z', title: 'Computer Lab', desc: 'Latest hardware with high-speed internet and coding curriculum.' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', title: 'Transport', desc: 'GPS-enabled buses covering all major routes across Indore city.' },
];
---

<section class="section bg-[var(--color-cream)]" id="facilities-preview">
  <div class="container">
    <SectionHeading
      title="World-Class Facilities"
      subtitle="Modern infrastructure designed to provide the best learning experience."
    />

    <div class="snap-container gap-6" data-animate="stagger">
      {facilities.map((facility) => (
        <div class="rounded-2xl bg-white border border-[var(--color-indigo)]/10 shadow-sm p-6 hover:-translate-y-1 hover:shadow-lg transition duration-300 snap-card">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-indigo)]/10 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-[var(--color-indigo)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d={facility.icon} />
            </svg>
          </div>
          <h3 class="font-semibold text-[var(--color-ink)] mb-2">{facility.title}</h3>
          <p class="text-sm text-[var(--color-ink-light)]">{facility.desc}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-10" data-animate="fade-up">
      <Button variant="outline-light" href="/facilities">
        Explore All Facilities
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </Button>
    </div>
  </div>
</section>

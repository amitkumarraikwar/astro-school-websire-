---
import SectionHeading from '@/components/ui/SectionHeading.astro';

const testimonials = [
  {
    name: 'Tarun Solanki',
    relation: 'Parent / Review on Justdial',
    quote: 'M P Public School stands out as a premier institution with its expert faculty and comprehensive curriculum. The dedicated teachers foster a supportive learning environment, ensuring students receive personalized attention.',
  },
  {
    name: 'Farhan Khan',
    relation: 'Parent / Review on Justdial',
    quote: 'I feel so fortunate that we had found this great school. My daughters had their primary programs there, which greatly fostered independence, confidence and intellectual development in them. Their staffs are kind, sincere people that I could trust.',
  },
  {
    name: 'Riddhi Sharma',
    relation: 'Student / Review on Justdial',
    quote: 'Best school. Proud to be MP PUBLICIANS ❤️😊. Fabulous atmosphere for students and well qualified teachers. Handle the child with care.',
  },
  {
    name: 'Aditya',
    relation: 'Parent / Review on Justdial',
    quote: 'The Best School in Indore !! Teachers are well trained to handle the present scenario. Special training is provided for child\'s holistic development. This is a great school, my children thrived in this atmosphere and learned so much.',
  },
];
---

<section class="section bg-[var(--color-cream)]" id="testimonials">
  <div class="container">
    <SectionHeading
      title="What Parents & Students Say"
      subtitle="Hear from the families and students who are part of our M.P. Public School community."
    />

    <div class="snap-container gap-6 md:gap-8" data-animate="stagger">
      {testimonials.map((testimonial) => (
        <div class="card p-7 md:p-8 relative snap-card">
          <!-- Quote mark -->
          <svg class="absolute top-6 right-6 w-10 h-10 text-[var(--color-amber)]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151C7.563 6.068 6 8.789 6 11h4v10H0z" />
          </svg>

          <p class="text-[var(--color-ink-light)] leading-relaxed mb-6 relative z-10">
            "{testimonial.quote}"
          </p>

          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-full bg-gradient-to-br from-[var(--color-indigo)] to-[var(--color-indigo-deep)] flex items-center justify-center text-white font-bold text-sm">
              {testimonial.name.charAt(0)}{testimonial.name.split(' ').pop()?.charAt(0)}
            </div>
            <div>
              <span class="block text-sm font-semibold text-[var(--color-ink)]">{testimonial.name}</span>
              <span class="block text-xs text-[var(--color-ink-light)]">{testimonial.relation}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

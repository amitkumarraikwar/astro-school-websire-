---
import { siteConfig } from '@/config/site';

const stats = [
  { value: siteConfig.stats.students, suffix: '+', label: 'Students Enrolled', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
  { value: siteConfig.stats.teachers, suffix: '+', label: 'Expert Faculty', icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z' },
  { value: new Date().getFullYear() - siteConfig.establishedYear, suffix: '+', label: 'Years of Excellence', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { value: 98, suffix: '%', label: 'Board Results', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' },
];
---

<section class="section bg-white relative overflow-hidden">
  <!-- Decorative background shapes -->
  <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-[var(--color-indigo)]/3 -translate-y-1/2 translate-x-1/3 blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full bg-[var(--color-amber)]/5 translate-y-1/3 -translate-x-1/4 blur-2xl"></div>

  <div class="container relative">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8" data-animate="stagger">
      {stats.map((stat) => (
        <div class="text-center group">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-[var(--color-indigo)] to-[var(--color-indigo-deep)] flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={stat.icon} />
            </svg>
          </div>
          <div
            class="text-4xl md:text-5xl font-bold text-[var(--color-indigo)] mb-2"
            data-counter={stat.value}
            data-counter-suffix={stat.suffix}
           
          >
            {stat.value}{stat.suffix}
          </div>
          <p class="text-sm md:text-base text-[var(--color-ink-light)] font-medium">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

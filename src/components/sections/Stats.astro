---
import { siteConfig } from '@/config/site';

const stats = [
  { value: siteConfig.stats.classrooms, label: 'Classrooms' },
  { value: siteConfig.stats.labs, label: 'Laboratories' },
  { value: siteConfig.stats.library, label: 'Library' },
  { value: siteConfig.campusArea, label: 'Campus Area' },
];
---

<section class="section bg-white" aria-label="School infrastructure">
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map(stat => (
        <div class="text-center">
          <p class="text-3xl md:text-4xl font-bold text-[var(--color-indigo)] mb-2">{stat.value}</p>
          <p class="text-sm md:text-base text-[var(--color-ink-light)]">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

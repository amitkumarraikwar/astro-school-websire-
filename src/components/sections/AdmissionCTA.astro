---
import Button from '@/components/ui/Button.astro';
---

<section class="section relative overflow-hidden" id="admission-cta">
  <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-red)] to-[var(--color-red-dark)]"></div>

  <!-- Decorative shapes -->
  <div class="absolute top-0 right-0 w-60 h-60 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/4"></div>
  <div class="absolute bottom-0 left-0 w-40 h-40 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/4"></div>

  <div class="container relative text-center" data-animate="fade-up">
    <div class="max-w-3xl mx-auto">
      <span class="badge bg-white/20 text-white mb-6">
        Admission Enquiries
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6">
        Let's Talk About Your Child's Education
      </h2>
      <p class="text-lg text-white/85 mb-10 max-w-xl mx-auto">
        Speak with the school office about class availability, subject choices, the current fee schedule, and a visit to our Ashok Nagar campus.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button variant="secondary" size="lg" href="/admissions">
          Explore Admissions
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </Button>
        <Button size="lg" href="/contact" class="bg-white/10 text-white border-2 border-white/30 hover:bg-white/20 hover:border-white/50">
          Schedule a Visit
        </Button>
      </div>
    </div>
  </div>
</section>

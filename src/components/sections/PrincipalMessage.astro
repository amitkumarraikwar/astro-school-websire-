---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import principalImg from '@/assets/images/principal-placeholder.jpg';
---

<section class="section gradient-indigo relative overflow-hidden" id="principal-message">
  <!-- Decorative shapes -->
  <div class="absolute top-10 right-10 w-40 h-40 rounded-full bg-white/5 blur-2xl"></div>
  <div class="absolute bottom-10 left-10 w-32 h-32 rounded-full bg-[var(--color-amber)]/10 blur-2xl"></div>

  <div class="container relative">
    <div class="grid lg:grid-cols-5 gap-10 lg:gap-16 items-center">
      <!-- Photo -->
      <div class="lg:col-span-2" data-animate="fade-up">
        <div class="relative max-w-sm mx-auto lg:mx-0">
          <div class="aspect-[3/4] rounded-3xl overflow-hidden bg-[var(--color-indigo-light)]/30 shadow-2xl relative">
            <Image 
              src={principalImg} 
              alt="Principal Portrait Placeholder" 
              class="w-full h-full object-cover"
              widths={[300, 600]}
              sizes="(max-width: 1024px) 300px, 400px"
              loading="lazy"
            />
          </div>
          <!-- Name tag -->
          <div class="absolute -bottom-4 left-4 right-4 bg-white rounded-xl shadow-xl p-4 text-center">
            <h3 class="font-bold text-[var(--color-ink)]">Dr. Rajesh Kumar Sharma</h3>
            <p class="text-sm text-[var(--color-indigo)] font-medium">Principal, M.P. Public School</p>
          </div>
        </div>
      </div>

      <!-- Message -->
      <div class="lg:col-span-3 pt-8 lg:pt-0" data-animate="fade-up">
        <SectionHeading
          title="Principal's Message"
          align="left"
          light={true}
        />

        <div class="relative pl-6 border-l-2 border-[var(--color-amber)]/40">
          <svg class="absolute -top-2 -left-4 w-8 h-8 text-[var(--color-amber)]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151C7.563 6.068 6 8.789 6 11h4v10H0z" />
          </svg>

          <blockquote class="text-white/85 text-lg leading-relaxed space-y-4">
            <p>
              Education is not merely the acquisition of knowledge — it is the ignition of curiosity, the cultivation of character, and the empowerment of young minds to make a positive difference in the world.
            </p>
            <p>
              At M.P. Public School, we are committed to providing an environment where every child feels valued, challenged, and inspired. Our dedicated faculty, modern infrastructure, and holistic curriculum work in harmony to bring out the best in each student.
            </p>
            <p>
              I invite you to be a part of the M.P. Public School family, where together, we shape the leaders of tomorrow.
            </p>
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>

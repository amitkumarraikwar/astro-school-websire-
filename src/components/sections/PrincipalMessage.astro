---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import principalImg from '@/assets/images/principal_image.jpeg';
---

<section class="section gradient-indigo relative overflow-hidden" id="principal-message">
  <div class="container relative">
    <div class="grid lg:grid-cols-5 gap-10 lg:gap-16 items-center">
      <!-- Photo -->
      <div class="lg:col-span-2" data-animate="fade-up">
        <div class="relative max-w-sm mx-auto lg:mx-0">
          <div class="aspect-[3/4] rounded-3xl overflow-hidden bg-[var(--color-indigo-light)]/30 shadow-2xl relative">
            <Image 
              src={principalImg} 
              alt="Mrs. Shraddha Pardeshi, Principal of M.P. Public School"
              class="w-full h-full object-cover"
              widths={[300, 600]}
              sizes="(max-width: 1024px) 300px, 400px"
              loading="lazy"
            />
          </div>
          <!-- Name tag -->
          <div class="absolute -bottom-4 left-4 right-4 bg-white rounded-xl shadow-xl p-4 text-center">
            <h3 class="font-bold text-[var(--color-ink)]">Mrs. Shraddha Pardeshi</h3>
            <p class="text-sm text-[var(--color-indigo)] font-medium">Principal, MSc.(B.Ed)</p>
          </div>
        </div>
      </div>

      <!-- Message -->
      <div class="lg:col-span-3 pt-8 lg:pt-0" data-animate="fade-up">
        <SectionHeading
          title="The school programme"
          align="left"
          light={true}
        />

        <div class="relative pl-6 border-l-2 border-[var(--color-amber)]/40">
          <div class="text-white/85 text-lg leading-relaxed space-y-4">
            <p>
              Mrs. Shraddha Pardeshi, MSc, B.Ed, is the Principal of M.P. Public School.
            </p>
            <p>
              The school programme lists classroom learning alongside music, dance, art and craft, games, sports, yoga, and cultural and literary activities.
            </p>
            <p>
              Ask the office about the current timetable, subject combinations, facilities, and arrangements for your child's class.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

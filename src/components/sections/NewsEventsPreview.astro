---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import newsImg from '@/assets/images/news-placeholder.jpg';
---

<section class="section bg-[var(--color-cream)]" id="news-events">
  <div class="container">
    <SectionHeading
      title="Latest News & Events"
      subtitle="Stay updated with the latest happenings at M.P. Public School, Indore."
    />

    <div class="snap-container gap-6 md:gap-8" data-animate="stagger">
      <!-- News Card 1 -->
      <a href="/news/cbse-results-2025" class="card group snap-card">
        <div class="aspect-[16/10] bg-[var(--color-indigo)] relative overflow-hidden">
          <Image
            src={newsImg}
            alt="News Placeholder"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            widths={[400, 800]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 400px"
            loading="lazy"
          />
          <div class="absolute top-3 left-3">
            <span class="badge badge-amber">Achievement</span>
          </div>
        </div>
        <div class="p-6">
          <time class="text-xs text-[var(--color-ink-light)] font-medium" datetime="2025-05-15">May 15, 2025</time>
          <h3 class="text-lg font-bold text-[var(--color-ink)] mt-2 mb-2 group-hover:text-[var(--color-indigo)] transition-colors">
            CBSE Board Results 2025 – 98% Pass Rate
          </h3>
          <p class="text-sm text-[var(--color-ink-light)] line-clamp-2">
            Students shine in CBSE Board Examinations with outstanding results and 15 students scoring above 95%.
          </p>
        </div>
      </a>

      <!-- News Card 2 -->
      <a href="/news/smart-classrooms-inauguration" class="card group snap-card">
        <div class="aspect-[16/10] bg-[var(--color-indigo)] relative overflow-hidden">
          <Image
            src={newsImg}
            alt="News Placeholder"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            widths={[400, 800]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 400px"
            loading="lazy"
          />
          <div class="absolute top-3 left-3">
            <span class="badge badge-indigo">Announcement</span>
          </div>
        </div>
        <div class="p-6">
          <time class="text-xs text-[var(--color-ink-light)] font-medium" datetime="2025-07-10">July 10, 2025</time>
          <h3 class="text-lg font-bold text-[var(--color-ink)] mt-2 mb-2 group-hover:text-[var(--color-indigo)] transition-colors">
            New Smart Classrooms Inaugurated
          </h3>
          <p class="text-sm text-[var(--color-ink-light)] line-clamp-2">
            20 classrooms upgraded with interactive whiteboards, projectors, and digital learning tools.
          </p>
        </div>
      </a>

      <!-- Upcoming Event -->
      <div class="card p-6 flex flex-col snap-card">
        <div class="mb-4">
          <span class="badge badge-red">Upcoming Event</span>
        </div>

        <div class="space-y-4 flex-1">
          <div class="flex gap-4 items-start p-3 rounded-xl bg-[var(--color-cream)] hover:bg-[var(--color-cream-dark)] transition-colors">
            <div class="text-center shrink-0 w-14">
              <span class="block text-2xl font-bold text-[var(--color-red)]">15</span>
              <span class="block text-xs font-semibold text-[var(--color-ink-light)] uppercase">Dec</span>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-[var(--color-ink)]">Annual Day Celebration 2025</h4>
              <p class="text-xs text-[var(--color-ink-light)] mt-1">4:00 PM · School Auditorium</p>
            </div>
          </div>

          <div class="flex gap-4 items-start p-3 rounded-xl bg-[var(--color-cream)] hover:bg-[var(--color-cream-dark)] transition-colors">
            <div class="text-center shrink-0 w-14">
              <span class="block text-2xl font-bold text-[var(--color-red)]">20</span>
              <span class="block text-xs font-semibold text-[var(--color-ink-light)] uppercase">Nov</span>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-[var(--color-ink)]">Inter-School Sports Tournament</h4>
              <p class="text-xs text-[var(--color-ink-light)] mt-1">8:00 AM · Sports Complex</p>
            </div>
          </div>

          <div class="flex gap-4 items-start p-3 rounded-xl bg-[var(--color-cream)] hover:bg-[var(--color-cream-dark)] transition-colors">
            <div class="text-center shrink-0 w-14">
              <span class="block text-2xl font-bold text-[var(--color-red)]">25</span>
              <span class="block text-xs font-semibold text-[var(--color-ink-light)] uppercase">Oct</span>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-[var(--color-ink)]">Science Exhibition 2025</h4>
              <p class="text-xs text-[var(--color-ink-light)] mt-1">10:00 AM · School Campus</p>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[var(--color-gray-200)]">
          <a href="/news" class="text-sm font-semibold text-[var(--color-indigo)] hover:text-[var(--color-indigo-deep)] transition-colors flex items-center gap-1">
            View All Events
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="text-center mt-10" data-animate="fade-up">
      <Button variant="primary" href="/news">
        All News & Events
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </Button>
    </div>
  </div>
</section>

---
import { getCollection } from 'astro:content';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/config/site';
interface Props { preview?: boolean; }
const { preview = true } = Astro.props;
const publishedNews = (await getCollection('news', ({ data }) => data.published)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const calendarEntries = (await getCollection('events', ({ data }) => data.published && data.date >= today)).sort((a, b) => a.data.date.localeCompare(b.data.date));
const news = preview ? publishedNews.slice(0, 3) : publishedNews;
const events = preview ? calendarEntries.slice(0, 3) : calendarEntries;
const displayDate = (date: Date) => date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });
---

<section class="section bg-[var(--color-cream)]" id="news-events">
  <div class="container">
    <SectionHeading title="School Updates" subtitle="School documents and information for parents and guardians." />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {news.map(article => <a href={`/news/${article.id}`} class="card p-6 hover:shadow-lg transition-shadow"><span class="badge badge-indigo mb-3">School Information</span><h2 class="text-xl font-bold mb-3">{article.data.title}</h2><p class="text-[var(--color-ink-light)] text-sm mb-4">{article.data.description}</p><time datetime={article.data.date.toISOString()} class="text-xs text-[var(--color-ink-light)]">Published {displayDate(article.data.date)}</time><span class="block text-[var(--color-indigo)] font-semibold mt-4">Read Update →</span></a>)}
    </div>
    <h2 class="text-2xl font-bold mb-3">From the {siteConfig.academicSession} School Calendar</h2>
    <p class="text-sm text-[var(--color-ink-light)] mb-6">Dates below are listed in the school diary and may be updated by the school. Confirm timings and arrangements with the office. <a href={siteConfig.documents.diary} target="_blank" rel="noopener noreferrer" class="underline">Read the source calendar (PDF)</a>.</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {events.map(event => <div class="card p-6"><time datetime={event.data.date} class="text-sm font-semibold text-[var(--color-indigo)]">{displayDate(new Date(`${event.data.date}T00:00:00+05:30`))}</time><h3 class="text-lg font-bold mt-2 mb-3">{event.data.title}</h3><p class="text-sm text-[var(--color-ink-light)]">{event.data.description}</p>{event.data.venue && <p class="text-sm mt-3">{event.data.venue}</p>}</div>)}
    </div>
    {events.length === 0 && <p>No later diary dates are listed here. Contact the school for the current programme.</p>}
    {preview && <div class="text-center mt-10"><Button href="/news">All School Updates & Calendar Dates</Button></div>}
  </div>
</section>

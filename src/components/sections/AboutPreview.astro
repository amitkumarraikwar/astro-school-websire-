---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import campusImg from '@/assets/images/mpps_front1.jpeg';
import { siteConfig } from '@/config/site';
---

<section class="section bg-[var(--color-cream)]" id="about-preview">
  <div class="container">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Image side -->
      <div class="relative" data-animate="fade-up">
        <div class="relative rounded-3xl overflow-hidden shadow-xl aspect-[4/3] bg-[var(--color-indigo)]">
          <Image
            src={campusImg}
            alt="M.P. Public School Indore campus building facade"
            class="w-full h-full object-cover"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 800px"
            loading="lazy"
          />
        </div>
        <!-- Floating badge -->
        <div class="absolute -bottom-4 -right-4 md:bottom-6 md:right-[-1.5rem] bg-white rounded-2xl shadow-xl p-4 md:p-5 flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-amber)] flex items-center justify-center">
            <svg class="w-6 h-6 text-[var(--color-ink)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <span class="block text-2xl font-bold text-[var(--color-ink)]">MP Board</span>
            <span class="block text-xs text-[var(--color-ink-light)]">Affiliation No. {siteConfig.affiliationNumber}</span>
          </div>
        </div>
      </div>

      <!-- Content side -->
      <div>
        <SectionHeading
          title="Welcome to M.P. Public School"
          subtitle="Learning, activities, and school life at our Ashok Nagar campus."
          align="left"
        />

        <div class="space-y-4 text-[var(--color-ink-light)] leading-relaxed" data-animate="fade-up">
          <p>
            M.P. Public School serves families in Indore with education from Pre-Primary to Class XII. Our campus has 19 classrooms, four laboratories, and a library, within a 20,000 sq. ft. site.
          </p>
          <p>
            The school's activity programme includes art and craft, music, dance, indoor and outdoor games, sports, and yoga. Parents can speak with the school office about classes, subject choices, fees, and a campus visit.
          </p>
          
          <!-- GEO: Fact Table -->
          <div class="mt-6 border border-[var(--color-indigo)]/10 rounded-xl overflow-hidden bg-white shadow-sm">
            <table class="w-full text-sm text-left">
              <caption class="bg-[var(--color-indigo)]/5 p-3 font-bold text-[var(--color-ink)] border-b border-[var(--color-indigo)]/10">M.P. Public School At a Glance</caption>
              <tbody class="divide-y divide-[var(--color-indigo)]/10">
                <tr><th class="py-2 px-4 text-[var(--color-ink)] font-semibold w-1/3">Campus</th><td class="py-2 px-4 text-[var(--color-ink-light)]">{siteConfig.campusArea}</td></tr>
                <tr><th class="py-2 px-4 text-[var(--color-ink)] font-semibold">Affiliation</th><td class="py-2 px-4 text-[var(--color-ink-light)]">MP Board ({siteConfig.affiliationNumber})</td></tr>
                <tr><th class="py-2 px-4 text-[var(--color-ink)] font-semibold">Classes</th><td class="py-2 px-4 text-[var(--color-ink-light)]">Pre-Primary to Class 12</td></tr>
                <tr><th class="py-2 px-4 text-[var(--color-ink)] font-semibold">Location</th><td class="py-2 px-4 text-[var(--color-ink-light)]">Indore, M.P.</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="flex flex-wrap gap-4 mt-8" data-animate="fade-up">
          <Button variant="primary" href="/about">
            Learn More About Us
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

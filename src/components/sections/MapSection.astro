---
import { siteConfig } from '@/config/site';
---

<section class="section bg-white" id="location">
  <div class="container">
    <div class="grid lg:grid-cols-3 gap-8 items-start">
      <!-- Info -->
      <div data-animate="fade-up">
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-ink)] mb-4">Find Us</h2>
        <p class="text-[var(--color-ink-light)] mb-6">
          Visit our Ashok Nagar campus in Indore. Please call the office before visiting to confirm availability and directions.
        </p>
        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-[var(--color-cyan)] shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="text-sm text-[var(--color-ink-light)]">
              {siteConfig.address}
            </p>
          </div>
          <a href={`tel:${siteConfig.phones[0].replace(/[^0-9+]/g, '')}`} class="flex items-center gap-3 text-sm text-[var(--color-ink-light)] hover:text-[var(--color-indigo)] transition-colors">
            <svg class="w-5 h-5 text-[var(--color-cyan)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {siteConfig.phones[0]}
          </a>
        </div>
      </div>

      <!-- Map -->
      <div class="lg:col-span-2 rounded-2xl overflow-hidden shadow-lg h-[360px]" data-animate="fade-up">
        {siteConfig.mapUrl ? (
          <iframe
            src={siteConfig.mapUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="M.P. Public School Indore Location on Google Maps"
            class="w-full h-full object-cover"
          ></iframe>
        ) : (
          <div class="w-full h-full bg-[var(--color-gray-100)] flex flex-col items-center justify-center p-6 text-center">
            <svg class="w-12 h-12 text-[var(--color-gray-400)] mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="text-[var(--color-ink-light)] mb-4">{siteConfig.address}</p>
            <a href={`https://maps.google.com/?q=${encodeURIComponent(siteConfig.address)}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-4 py-2 bg-[var(--color-indigo)] text-white text-sm font-semibold rounded-full hover:bg-[var(--color-indigo-deep)] transition-colors">
              Open in Google Maps
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { eventMedia } from '@/data/eventMedia';

const previewMedia = eventMedia.filter((media) => media.type === 'image').slice(0, 6);
---

<section class="section bg-white" id="event-media-preview">
  <div class="container">
    <SectionHeading
      title="Life Around Our School"
      subtitle="Explore school-provided photos from recent activities, celebrations, and events."
    />

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6" data-animate="stagger" aria-label="Recent school event photos">
      {previewMedia.map((media, index) => (
        <a
          href={media.src}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative overflow-hidden rounded-2xl bg-[var(--color-gray-100)] shadow-sm aspect-[4/3]"
          aria-label={`Open school event photo ${index + 1}`}
        >
          <img
            src={media.src}
            alt={media.alt}
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
          />
          <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-4 pt-8 pb-3 text-xs font-semibold text-white">
            Event photo {index + 1}
          </span>
        </a>
      ))}
    </div>

    <div class="text-center mt-10">
      <Button href="/gallery#event-media" variant="outline-light">
        View All Event Media
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </Button>
    </div>
  </div>
</section>

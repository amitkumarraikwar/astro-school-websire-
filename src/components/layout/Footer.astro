---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'Academics', href: '/academics' },
  { label: 'Admissions', href: '/admissions' },
  { label: 'Faculty', href: '/faculty' },
  { label: 'Facilities', href: '/facilities' },
  { label: 'Gallery', href: '/gallery' },
];

const importantLinks = [
  { label: 'News & Events', href: '/news' },
  { label: 'Contact Us', href: '/contact' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms & Conditions', href: '/terms' },
];

const socialLinks = [
  { label: 'Facebook', href: 'https://www.facebook.com/mppublicschoolindore', icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  { label: 'Instagram', href: 'https://www.instagram.com/mppublicschoolindore', icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
  { label: 'YouTube', href: 'https://www.youtube.com/@mppublicschoolindore', icon: 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
];
---

<footer class="relative overflow-hidden" role="contentinfo">
  <!-- Decorative top wave -->
  <div class="absolute top-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
      <path d="M0 80L60 68.3C120 57 240 33 360 25C480 17 600 25 720 33.3C840 42 960 50 1080 46.3C1200 42 1320 27 1380 19.2L1440 12V0H0V80Z" fill="white"/>
    </svg>
  </div>

  <div class="gradient-indigo pt-24 pb-8">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 mb-12">
        <!-- School Info -->
        <div class="lg:col-span-1">
          <a href="/" class="flex items-center gap-3 mb-5">
            <img
              src="/logo.png"
              alt="M.P. Public School Indore Logo"
              width="48"
              height="48"
              class="rounded-full"
              loading="lazy"
            />
            <div>
              <span class="block text-lg font-bold text-white">M.P. Public School</span>
              <span class="block text-xs text-white/60">Indore, Madhya Pradesh</span>
            </div>
          </a>
          <p class="text-white/70 text-sm leading-relaxed mb-6">
            Nurturing young minds since 1995. A premier CBSE-affiliated school in Indore committed to academic excellence and holistic development.
          </p>
          <!-- Social Links -->
          <div class="flex items-center gap-3">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Follow us on ${social.label}`}
                class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center hover:bg-[var(--color-amber)] transition-colors duration-200 group"
              >
                <svg class="w-4 h-4 fill-white group-hover:fill-[var(--color-ink)]" viewBox="0 0 24 24">
                  <path d={social.icon} />
                </svg>
              </a>
            ))}
          </div>
        </div>

        <!-- Quick Links -->
        <div>
          <h3 class="text-white font-semibold text-base mb-5 flex items-center gap-2">
            <span class="w-6 h-0.5 bg-[var(--color-amber)] rounded-full"></span>
            Quick Links
          </h3>
          <ul class="space-y-2.5">
            {quickLinks.map((link) => (
              <li>
                <a href={link.href} class="text-white/70 text-sm hover:text-[var(--color-amber)] transition-colors duration-200 flex items-center gap-2">
                  <svg class="w-3 h-3 text-[var(--color-amber)]/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Important Links -->
        <div>
          <h3 class="text-white font-semibold text-base mb-5 flex items-center gap-2">
            <span class="w-6 h-0.5 bg-[var(--color-amber)] rounded-full"></span>
            Important
          </h3>
          <ul class="space-y-2.5">
            {importantLinks.map((link) => (
              <li>
                <a href={link.href} class="text-white/70 text-sm hover:text-[var(--color-amber)] transition-colors duration-200 flex items-center gap-2">
                  <svg class="w-3 h-3 text-[var(--color-amber)]/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contact Info -->
        <div>
          <h3 class="text-white font-semibold text-base mb-5 flex items-center gap-2">
            <span class="w-6 h-0.5 bg-[var(--color-amber)] rounded-full"></span>
            Contact Us
          </h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[var(--color-cyan)] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="text-white/70 text-sm">AB Road, Near Palasia Square,<br/>Indore, Madhya Pradesh – 452001</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-[var(--color-cyan)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <a href="tel:+917312345678" class="text-white/70 text-sm hover:text-[var(--color-amber)] transition-colors">+91 731-234-5678</a>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-[var(--color-cyan)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <a href="mailto:info@mppublicschoolindore.com" class="text-white/70 text-sm hover:text-[var(--color-amber)] transition-colors">info@mppublicschoolindore.com</a>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-[var(--color-cyan)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-white/70 text-sm">Mon – Sat: 8:00 AM – 3:00 PM</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-white/50 text-sm text-center sm:text-left">
          &copy; {currentYear} M.P. Public School, Indore. All rights reserved.
        </p>
        <div class="flex items-center gap-4 text-sm">
          <a href="/privacy-policy" class="text-white/50 hover:text-white/80 transition-colors">Privacy</a>
          <span class="text-white/20">|</span>
          <a href="/terms" class="text-white/50 hover:text-white/80 transition-colors">Terms</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- WhatsApp Float -->
<a
  href="https://wa.me/917312345678?text=Hello%2C%20I%20would%20like%20to%20know%20more%20about%20M.P.%20Public%20School."
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp"
  class="fixed bottom-6 right-6 z-[300] w-14 h-14 rounded-full bg-[#25D366] hidden lg:flex items-center justify-center shadow-xl hover:scale-110 transition-transform duration-200 hover:shadow-2xl"
>
  <svg class="w-7 h-7 fill-white" viewBox="0 0 24 24">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>

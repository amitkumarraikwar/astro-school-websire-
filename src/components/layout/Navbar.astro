---
import { ChevronDown, ChevronRight, ArrowRight } from 'lucide-react';
const currentPath = Astro.url.pathname;

interface NavItem {
  label: string;
  href: string;
  children?: { label: string; href: string; desc?: string }[];
}

const navItems: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  {
    label: 'Academics',
    href: '/academics',
    children: [
      { label: 'Curriculum & Levels', href: '/academics', desc: 'Pre-Primary to Senior Secondary' },
      { label: 'Faculty & Staff', href: '/faculty', desc: 'Our dedicated educators' },
      { label: 'Facilities', href: '/facilities', desc: 'World-class infrastructure' },
    ],
  },
  { label: 'Admissions', href: '/admissions' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'News & Events', href: '/news' },
  { label: 'Contact', href: '/contact' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  id="main-header"
  class="fixed top-0 z-[150] transition-transform duration-300 w-full safe-pt bg-white/90 backdrop-blur-md border-b border-[var(--color-gray-200)] shadow-sm select-none"
  role="banner"
>
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-14 lg:h-20 flex items-center justify-between" role="navigation" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 lg:gap-3 shrink-0" aria-label="M.P. Public School Home">
      <img
        src="/logo.png"
        alt="M.P. Public School Indore Logo"
        width="48"
        height="48"
        class="h-8 w-8 lg:h-12 lg:w-12 object-contain rounded-full shadow-sm lg:shadow-md"
        loading="eager"
      />
      <div>
        <span class="block text-base lg:text-lg font-bold leading-tight text-[var(--color-ink)] header-title">M.P. Public School</span>
        <span class="hidden sm:block text-[10px] lg:text-xs font-medium text-[var(--color-ink-light)] header-subtitle">Indore, Madhya Pradesh</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex items-center gap-6 xl:gap-8">
      {navItems.map((item) => (
        <div class="relative group">
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-1 px-3 py-2 text-[15px] font-medium transition-colors duration-200 whitespace-nowrap',
              isActive(item.href)
                ? 'text-[var(--color-indigo)] border-b-2 border-[var(--color-amber)]'
                : 'text-[var(--color-ink)] hover:text-[var(--color-indigo)]',
            ]}
          >
            {item.label}
            {item.children && (
              <ChevronDown class="inline-block w-4 h-4 transition-transform duration-200 group-hover:rotate-180" strokeWidth={2.5} />
            )}
          </a>

          {/* Mega dropdown */}
          {item.children && (
            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
              <div class="bg-white rounded-2xl shadow-xl border border-[var(--color-gray-200)] p-4 min-w-[280px]">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="flex items-start gap-3 p-3 rounded-xl hover:bg-[var(--color-cream)] transition-colors duration-150"
                  >
                    <div class="w-8 h-8 rounded-lg bg-[var(--color-indigo)]/10 flex items-center justify-center mt-0.5 shrink-0">
                      <ChevronRight class="w-4 h-4 text-[var(--color-indigo)]" strokeWidth={2} />
                    </div>
                    <div>
                      <span class="block text-sm font-semibold text-[var(--color-ink)]">{child.label}</span>
                      {child.desc && <span class="block text-xs text-[var(--color-gray-500)] mt-0.5">{child.desc}</span>}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-3 shrink-0">
      <!-- Mobile Apply Pill -->
      <a
        href="/admissions"
        class="lg:hidden inline-flex items-center px-3 py-1.5 bg-[var(--color-indigo)]/10 text-[var(--color-indigo)] text-xs font-bold rounded-full active:scale-95 transition-transform"
      >
        Apply
      </a>

      <!-- Desktop Apply Button -->
      <a
        href="/admissions"
        class="hidden lg:inline-flex items-center gap-2 px-6 py-2.5 bg-[var(--color-red)] text-white text-sm font-semibold rounded-full hover:brightness-110 transition-all duration-200 shadow-md shrink-0 whitespace-nowrap"
      >
        Apply Now
        <ArrowRight class="w-4 h-4 shrink-0" strokeWidth={2.5} />
      </a>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('main-header');
    let lastScrollY = window.scrollY;

    function handleScroll() {
      if (!header || window.innerWidth >= 1024) return; // Only hide on mobile

      const currentScrollY = window.scrollY;
      
      // Scroll Down -> Hide
      if (currentScrollY > lastScrollY && currentScrollY > 60) {
        header.classList.add('-translate-y-full');
      } 
      // Scroll Up -> Show
      else {
        header.classList.remove('-translate-y-full');
      }

      lastScrollY = currentScrollY;
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    
    // Cleanup on unmount
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', handleScroll);
    }, { once: true });
  });
</script>
